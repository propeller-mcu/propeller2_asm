' =========================================================
'
' P2ASM OLED DEMO 109 / 119
'
' Screen Saver Pattern
'
' Category: HUB RAM Animation
'
' =========================================================

CON

    _CLKFREQ = 180_000_000

    oled_sck   = 0
    oled_mosi  = 1
    oled_reset = 2
    oled_dc    = 3
    oled_cs    = 4

DAT

    org 0
    asmclk

' -------------------------
' GPIO INIT
' -------------------------

    drvh    #oled_cs
    drvh    #oled_dc
    drvl    #oled_sck
    dirh    #oled_mosi
    dirh    #oled_dc
    dirh    #oled_reset
    dirh    #oled_cs
    dirh    #oled_sck

' =========================
' MAIN
' =========================

main

    call    #reset_oled
    call    #oled_init

' -------------------------
' START POSITION
' -------------------------

    mov     center_x, #20
    mov     center_y, #16

' -------------------------
' DIRECTION FLAGS
'
' x_direction
'
' 0 = right
' 1 = left
'
' y_direction
'
' 0 = down
' 1 = up
' -------------------------

    mov     x_direction, #0
    mov     y_direction, #0

' =========================
' SCREEN SAVER LOOP
'
' One fixed diamond bounces
' around the screen forever.
'
' No signed direction values
' are used.
' =========================

screen_saver_loop

    call    #clear_buffer

' -------------------------
' DRAW DIAMOND
' -------------------------

    mov     shape_size, #7

    call    #draw_diamond_outline

' -------------------------
' DRAW CENTER PIXEL
' -------------------------

    mov     xpos, center_x
    mov     ypos, center_y

    call    #set_pixel

' -------------------------
' DISPLAY FRAME
' -------------------------

    call    #push_buffer

    call    #frame_delay

' =========================
' MOVE X
' =========================

    cmp     x_direction, #0 wz

if_z    jmp     #move_right

' -------------------------
' MOVE LEFT
' -------------------------

move_left

    sub     center_x, #1

' -------------------------
' HIT LEFT WALL?
' -------------------------

    cmp     center_x, #7 wz

if_z    mov     x_direction, #0

    jmp     #move_y

' -------------------------
' MOVE RIGHT
' -------------------------

move_right

    add     center_x, #1

' -------------------------
' HIT RIGHT WALL?
'
' center 120 + radius 7 = 127
' -------------------------

    cmp     center_x, #120 wz

if_z    mov     x_direction, #1

' =========================
' MOVE Y
' =========================

move_y

    cmp     y_direction, #0 wz

if_z    jmp     #move_down

' -------------------------
' MOVE UP
' -------------------------

move_up

    sub     center_y, #1

' -------------------------
' HIT TOP WALL?
' -------------------------

    cmp     center_y, #7 wz

if_z    mov     y_direction, #0

    jmp     #screen_saver_loop

' -------------------------
' MOVE DOWN
' -------------------------

move_down

    add     center_y, #1

' -------------------------
' HIT BOTTOM WALL?
'
' center 56 + radius 7 = 63
' -------------------------

    cmp     center_y, #56 wz

if_z    mov     y_direction, #1

    jmp     #screen_saver_loop

' =========================
' DRAW DIAMOND OUTLINE
'
' center_x
' center_y
' shape_size
'
' Draws four connected
' 45-degree edges.
' =========================

draw_diamond_outline

    mov     shape_step, #0

draw_diamond_loop

' -------------------------
' TOP TO RIGHT
' -------------------------

    mov     xpos, center_x
    add     xpos, shape_step

    mov     ypos, center_y
    sub     ypos, shape_size
    add     ypos, shape_step

    call    #set_pixel

' -------------------------
' RIGHT TO BOTTOM
' -------------------------

    mov     xpos, center_x
    add     xpos, shape_size
    sub     xpos, shape_step

    mov     ypos, center_y
    add     ypos, shape_step

    call    #set_pixel

' -------------------------
' BOTTOM TO LEFT
' -------------------------

    mov     xpos, center_x
    sub     xpos, shape_step

    mov     ypos, center_y
    add     ypos, shape_size
    sub     ypos, shape_step

    call    #set_pixel

' -------------------------
' LEFT TO TOP
' -------------------------

    mov     xpos, center_x
    sub     xpos, shape_size
    add     xpos, shape_step

    mov     ypos, center_y
    sub     ypos, shape_step

    call    #set_pixel

' -------------------------
' NEXT STEP
' -------------------------

    add     shape_step, #1

    cmp     shape_step, shape_size wz

if_nz   jmp     #draw_diamond_loop

' -------------------------
' DRAW LAST CORNER SET
' -------------------------

    mov     xpos, center_x
    add     xpos, shape_step

    mov     ypos, center_y
    sub     ypos, shape_size
    add     ypos, shape_step

    call    #set_pixel

    mov     xpos, center_x
    add     xpos, shape_size
    sub     xpos, shape_step

    mov     ypos, center_y
    add     ypos, shape_step

    call    #set_pixel

    mov     xpos, center_x
    sub     xpos, shape_step

    mov     ypos, center_y
    add     ypos, shape_size
    sub     ypos, shape_step

    call    #set_pixel

    mov     xpos, center_x
    sub     xpos, shape_size
    add     xpos, shape_step

    mov     ypos, center_y
    sub     ypos, shape_step

    call    #set_pixel

    ret

' =========================
' RESET OLED
' =========================

reset_oled

    drvl    #oled_reset
    waitx   ##20_000

    drvh    #oled_reset
    waitx   ##9_000_000

    ret

' =========================
' OLED INIT
' =========================

oled_init

    mov     cmd, #$AE
    call    #send_cmd

    mov     cmd, #$D5
    call    #send_cmd

    mov     cmd, #$80
    call    #send_cmd

    mov     cmd, #$A8
    call    #send_cmd

    mov     cmd, #$3F
    call    #send_cmd

    mov     cmd, #$D3
    call    #send_cmd

    mov     cmd, #0
    call    #send_cmd

    mov     cmd, #$40
    call    #send_cmd

    mov     cmd, #$A0
    call    #send_cmd

    mov     cmd, #$C0
    call    #send_cmd

    mov     cmd, #$DA
    call    #send_cmd

    mov     cmd, #$12
    call    #send_cmd

    mov     cmd, #$81
    call    #send_cmd

    mov     cmd, #$7F
    call    #send_cmd

    mov     cmd, #$20
    call    #send_cmd

    mov     cmd, #$02
    call    #send_cmd

    mov     cmd, #$A4
    call    #send_cmd

    mov     cmd, #$A6
    call    #send_cmd

    mov     cmd, #$8D
    call    #send_cmd

    mov     cmd, #$14
    call    #send_cmd

    mov     cmd, #$AF
    call    #send_cmd

    ret

' =========================
' SEND COMMAND
' =========================

send_cmd

    drvl    #oled_cs
    drvl    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret

' =========================
' SEND DATA
' =========================

send_data

    drvl    #oled_cs
    drvh    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret

' =========================
' SET PAGE POSITION
' =========================

set_pos

    mov     cmd, page
    or      cmd, #$B0

    call    #send_cmd

    mov     cmd, #$00
    call    #send_cmd

    mov     cmd, #$10
    call    #send_cmd

    ret

' =========================
' CLEAR HUB FRAMEBUFFER
' =========================

clear_buffer

    mov     ptr, ##frame_buffer
    mov     count, ##256
    mov     value, #0

clear_buffer_loop

    wrlong  value, ptr

    add     ptr, #4

    djnz    count, #clear_buffer_loop

    ret

' =========================
' PUSH HUB FRAMEBUFFER
' =========================

push_buffer

    ' Read the HUB framebuffer from the end toward the beginning.
    ' Reversing byte order and bit order performs a 180-degree
    ' software rotation while keeping the OLED at $A0 / $C0.

    mov     ptr, ##frame_buffer
    add     ptr, ##1023

    mov     page, #0
    mov     page_count, #8

push_page_loop

    call    #set_pos
    mov     count, #128

push_column_loop

    rdbyte  cmd, ptr
    call    #rotate_display_byte
    call    #send_data

    sub     ptr, #1
    djnz    count, #push_column_loop

    add     page, #1
    djnz    page_count, #push_page_loop

    ret


' =========================
' REVERSE DATA BYTE FOR DISPLAY
'
' $A0/$C0 are kept as the controller's
' normal directions.  The module is mounted
' 180 degrees from the chosen viewing orientation,
' so framebuffer output is rotated in software.
' =========================

rotate_display_byte

    mov     rot_src, cmd
    mov     rot_dst, #0
    mov     rot_count, #8

rotate_display_byte_loop

    shl     rot_dst, #1
    testb   rot_src, #0 wc
if_c or      rot_dst, #1
    shr     rot_src, #1

    djnz    rot_count, #rotate_display_byte_loop

    mov     cmd, rot_dst
    ret

' =========================
' SET PIXEL IN HUB RAM
'
' xpos = 0 through 127
'
' ypos = 0 through 63
' =========================

set_pixel

    mov     offset, ypos

    shr     offset, #3
    shl     offset, #7

    add     offset, xpos

    mov     ptr, ##frame_buffer
    add     ptr, offset

    rdbyte  value, ptr

    mov     mask, #1

    mov     temp, ypos
    and     temp, #7

    shl     mask, temp

    or      value, mask

    wrbyte  value, ptr

    ret

' =========================
' FRAME DELAY
' =========================

frame_delay

    waitx   ##6_000_000

    ret

' =========================
' SOFTWARE SPI
' =========================

spi8

    mov     spi_count, #8

.loop

    testb   cmd, #7 wc

    outc    #oled_mosi

    waitx   ##100

    drvh    #oled_sck

    waitx   ##100

    drvl    #oled_sck

    waitx   ##100

    rol     cmd, #1

    djnz    spi_count, #.loop

    ret

' =========================
' END
' =========================

end

    jmp     #end

' =========================
' VARIABLES
' =========================

cmd             res 1
count           res 1
spi_count       res 1

page            res 1
page_count      res 1

xpos            res 1
ypos            res 1

temp            res 1
ptr             res 1

value           res 1
offset          res 1
mask            res 1

center_x        res 1
center_y        res 1

shape_size      res 1
shape_step      res 1

x_direction     res 1
y_direction     res 1

' =========================
' HUB RAM
' =========================


rot_src         res 1
rot_dst         res 1
rot_count       res 1

    orgh

' =========================
' FRAMEBUFFER
'
' 128 x 64 monochrome OLED
'
' 8 pages x 128 bytes
'
' = 1024 bytes
' =========================

frame_buffer

    byte    0[1024]