' =========================================================
'
' P2ASM OLED DEMO 021 / 119
'
' Down Arrow
'
' Category: OLED Graphics
'
' =========================================================

CON

    _CLKFREQ = 180_000_000

    oled_sck   = 0
    oled_mosi  = 1
    oled_reset = 2
    oled_dc    = 3
    oled_cs    = 4

DAT

    org 0
    asmclk

' -------------------------
' GPIO INIT
' -------------------------

    drvh    #oled_cs
    drvh    #oled_dc
    drvl    #oled_sck
    dirh    #oled_mosi
    dirh    #oled_dc
    dirh    #oled_reset
    dirh    #oled_cs
    dirh    #oled_sck


' =========================
' MAIN
' =========================

main

    call    #reset_oled
    call    #oled_init
    call    #clear_screen

    ' Draw down arrow
    '
    ' Image width  = 40 pixels
    ' Image height = 48 pixels
    '
    ' X = 44 through 83
    ' Y = 8 through 55
    '
    ' Shaft thickness
    ' = 10 pixels
    '
    ' Same proportions as
    ' the up arrow, flipped
    ' vertically.

    call    #draw_arrow

    jmp     #end


' =========================
' RESET OLED
' =========================

reset_oled

    drvl    #oled_reset
    waitx   ##20_000

    drvh    #oled_reset

    ' Give OLED time to stabilize

    waitx   ##9_000_000

    ret


' =========================
' OLED INIT
' =========================

oled_init

    mov     cmd, #$AE        ' Display off
    call    #send_cmd

    mov     cmd, #$D5        ' Display clock
    call    #send_cmd

    mov     cmd, #$80
    call    #send_cmd

    mov     cmd, #$A8        ' Multiplex ratio
    call    #send_cmd

    mov     cmd, #$3F        ' 64 rows
    call    #send_cmd

    mov     cmd, #$D3        ' Display offset
    call    #send_cmd

    mov     cmd, #0
    call    #send_cmd

    mov     cmd, #$40        ' Start line
    call    #send_cmd

    mov     cmd, #$A0        ' Normal segment direction
    call    #send_cmd

    mov     cmd, #$C0        ' Normal COM scan direction
    call    #send_cmd

    mov     cmd, #$DA        ' COM pin config
    call    #send_cmd

    mov     cmd, #$12
    call    #send_cmd

    mov     cmd, #$81        ' Contrast
    call    #send_cmd

    mov     cmd, #$7F
    call    #send_cmd

    mov     cmd, #$20        ' Addressing mode
    call    #send_cmd

    mov     cmd, #$02        ' Page addressing mode
    call    #send_cmd

    mov     cmd, #$A4        ' Use display RAM
    call    #send_cmd

    mov     cmd, #$A6        ' Normal display
    call    #send_cmd

    mov     cmd, #$8D        ' Charge pump
    call    #send_cmd

    mov     cmd, #$14
    call    #send_cmd

    mov     cmd, #$AF        ' Display on
    call    #send_cmd

    ret


' =========================
' SEND COMMAND
' =========================

send_cmd

    drvl    #oled_cs
    drvl    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret


' =========================
' SEND DATA
' =========================

send_data

    drvl    #oled_cs
    drvh    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret


' =========================
' SET PAGE POSITION
' =========================

set_pos

    mov     cmd, page
    or      cmd, #$B0
    call    #send_cmd

    mov     cmd, #$00
    call    #send_cmd

    mov     cmd, #$10
    call    #send_cmd

    ret


' =========================
' SET X POSITION
'
' xpos = 0 - 127
' =========================

set_xpos

    mov     temp, xpos
    and     temp, #$0F

    mov     cmd, temp
    call    #send_cmd

    mov     temp, xpos
    shr     temp, #4
    and     temp, #$0F
    or      temp, #$10

    mov     cmd, temp
    call    #send_cmd

    ret


' =========================
' CLEAR SCREEN
'
' 8 pages
' 128 bytes per page
' =========================

clear_screen

    mov     page, #0

clear_page_loop

    call    #set_pos

    mov     count, #128

clear_column_loop

    mov     cmd, #$00
    call    #send_data

    djnz    count, #clear_column_loop

    add     page, #1

    cmp     page, #8 wz

    if_nz   jmp     #clear_page_loop

    ret


' =========================
' DRAW DOWN ARROW
'
' Compact 40 x 48 image
'
' Starting X = 44
' Starting page = 1
'
' Width  = 40 bytes
' Height = 6 OLED pages
'
' 6 x 40
' = 240 HUB bytes
' =========================

draw_arrow

    mov     ptr, ##arrow_image
    mov     page, #1
    mov     page_count, #6

arrow_page_loop

    mov     cmd, page
    or      cmd, #$B0
    call    #send_cmd

    mov     xpos, #44
    call    #set_xpos

    mov     count, #40

arrow_column_loop

    rdbyte  cmd, ptr
    call    #send_data

    add     ptr, #1

    djnz    count, #arrow_column_loop

    add     page, #1

    djnz    page_count, #arrow_page_loop

    ret


' =========================
' SOFTWARE SPI
'
' Slow / beginner-friendly
' bit-banged SPI timing
' =========================

spi8

    mov     x, #8

.loop

    testb   cmd, #7 wc

    outc    #oled_mosi

    waitx   ##100

    drvh    #oled_sck
    waitx   ##100

    drvl    #oled_sck
    waitx   ##100

    rol     cmd, #1

    djnz    x, #.loop

    ret


' =========================
' END
' =========================

end

    jmp     #end


' =========================
' VARIABLES
' =========================

cmd         res 1
count       res 1
x           res 1
page        res 1
xpos        res 1
temp        res 1
ptr         res 1
page_count  res 1


' =========================
' DOWN ARROW IMAGE
'
' 40 pixels wide
' 48 pixels tall
'
' 10-pixel shaft
'
' Smooth symmetric
' triangular head
'
' 6 pages x 40 bytes
' = 240 HUB bytes
' =========================

    orgh


' NOTE: Bitmap data below is stored 180 degrees rotated in HUB RAM.
' The OLED is intentionally initialized with $A0 / $C0 (no controller remap).
' This software compensation makes the image appear upright in the chosen
' physical orientation of this 2.42-inch SSD1309 module.

arrow_image

' -------------------------
' PAGE 1
' Y = 8 through 15
'
' Bottom arrow tip
' -------------------------

    byte    $00,$00,$00,$00,$00,$00,$00,$00
    byte    $00,$00,$00,$00,$00,$00,$80,$E0
    byte    $F0,$F8,$FE,$FF,$FF,$FE,$F8,$F0
    byte    $E0,$80,$00,$00,$00,$00,$00,$00
    byte    $00,$00,$00,$00,$00,$00,$00,$00


' -------------------------
' PAGE 2
' Y = 16 through 23
'
' Arrow head widens
' -------------------------

    byte    $00,$00,$00,$00,$00,$00,$00,$00
    byte    $80,$C0,$E0,$F8,$FC,$FF,$FF,$FF
    byte    $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
    byte    $FF,$FF,$FF,$FC,$F8,$E0,$C0,$80
    byte    $00,$00,$00,$00,$00,$00,$00,$00


' -------------------------
' PAGE 3
' Y = 24 through 31
'
' Wide arrow head
' -------------------------

    byte    $00,$00,$00,$80,$E0,$F0,$FC,$FE
    byte    $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
    byte    $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
    byte    $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
    byte    $FE,$FC,$F0,$E0,$80,$00,$00,$00


' -------------------------
' PAGE 4
' Y = 32 through 39
'
' Head joins shaft
' -------------------------

    byte    $08,$0E,$0F,$0F,$0F,$0F,$0F,$0F
    byte    $0F,$0F,$0F,$0F,$0F,$0F,$0F,$FF
    byte    $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
    byte    $FF,$0F,$0F,$0F,$0F,$0F,$0F,$0F
    byte    $0F,$0F,$0F,$0F,$0F,$0F,$0E,$08


' -------------------------
' PAGE 5
' Y = 40 through 47
'
' Shaft
' -------------------------

    byte    $00,$00,$00,$00,$00,$00,$00,$00
    byte    $00,$00,$00,$00,$00,$00,$00,$FF
    byte    $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
    byte    $FF,$00,$00,$00,$00,$00,$00,$00
    byte    $00,$00,$00,$00,$00,$00,$00,$00


' -------------------------
' PAGE 6
' Y = 48 through 55
'
' Top of shaft
' -------------------------

    byte    $00,$00,$00,$00,$00,$00,$00,$00
    byte    $00,$00,$00,$00,$00,$00,$00,$FF
    byte    $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
    byte    $FF,$00,$00,$00,$00,$00,$00,$00
    byte    $00,$00,$00,$00,$00,$00,$00,$00