' =========================================================
'
' P2ASM OLED DEMO 099 / 119
'
' Sparkle Effect
'
' Category: HUB RAM Animation
'
' =========================================================

CON

    _CLKFREQ = 180_000_000

    oled_sck   = 0
    oled_mosi  = 1
    oled_reset = 2
    oled_dc    = 3
    oled_cs    = 4

DAT

    org 0
    asmclk

' -------------------------
' GPIO INIT
' -------------------------

    drvh    #oled_cs
    drvh    #oled_dc
    drvl    #oled_sck
    dirh    #oled_mosi
    dirh    #oled_dc
    dirh    #oled_reset
    dirh    #oled_cs
    dirh    #oled_sck

' =========================
' MAIN
' =========================

main

    call    #reset_oled
    call    #oled_init

    mov     frame_index, #0

' =========================
' SPARKLE EFFECT
'
' Each sparkle has:
'
' - X position
' - Y position
' - phase offset
'
' The phase determines whether
' the sparkle is:
'
' 0 = invisible
' 1 = single pixel
' 2 = small plus
' 3 = large sparkle
'
' Each star has a different
' starting phase, so they appear
' to twinkle independently.
' =========================

sparkle_loop

    call    #clear_buffer

    mov     sparkle_ptr, ##sparkle_data
    mov     sparkle_count, #18

' =========================
' DRAW ALL SPARKLES
' =========================

sparkle_item_loop

' -------------------------
' READ X
' -------------------------

    rdbyte  center_x, sparkle_ptr
    add     sparkle_ptr, #1

' -------------------------
' READ Y
' -------------------------

    rdbyte  center_y, sparkle_ptr
    add     sparkle_ptr, #1

' -------------------------
' READ PHASE OFFSET
' -------------------------

    rdbyte  sparkle_phase, sparkle_ptr
    add     sparkle_ptr, #1

' -------------------------
' CALCULATE CURRENT PHASE
'
' current phase =
'
' frame_index + phase offset
'
' Keep only lowest two bits:
'
' 0 through 3
' -------------------------

    mov     temp, frame_index
    add     temp, sparkle_phase
    and     temp, #3

' -------------------------
' PHASE 0
'
' Invisible
' -------------------------

    cmp     temp, #0 wz

if_z    jmp     #sparkle_next

' -------------------------
' PHASE 1
'
' Single bright pixel
' -------------------------

    cmp     temp, #1 wz

if_z    call    #draw_small_sparkle

    cmp     temp, #1 wz

if_z    jmp     #sparkle_next

' -------------------------
' PHASE 2
'
' Small four-point sparkle
' -------------------------

    cmp     temp, #2 wz

if_z    call    #draw_medium_sparkle

    cmp     temp, #2 wz

if_z    jmp     #sparkle_next

' -------------------------
' PHASE 3
'
' Large sparkle
' -------------------------

    call    #draw_large_sparkle

sparkle_next

    djnz    sparkle_count, #sparkle_item_loop

' =========================
' DISPLAY FRAME
' =========================

    call    #push_buffer

    call    #frame_delay

' -------------------------
' ADVANCE TWINKLE PHASE
' -------------------------

    add     frame_index, #1
    and     frame_index, #3

    jmp     #sparkle_loop

' =========================
' RESET OLED
' =========================

reset_oled

    drvl    #oled_reset
    waitx   ##20_000

    drvh    #oled_reset
    waitx   ##9_000_000

    ret

' =========================
' OLED INIT
' =========================

oled_init

    mov     cmd, #$AE
    call    #send_cmd

    mov     cmd, #$D5
    call    #send_cmd

    mov     cmd, #$80
    call    #send_cmd

    mov     cmd, #$A8
    call    #send_cmd

    mov     cmd, #$3F
    call    #send_cmd

    mov     cmd, #$D3
    call    #send_cmd

    mov     cmd, #0
    call    #send_cmd

    mov     cmd, #$40
    call    #send_cmd

    mov     cmd, #$A0
    call    #send_cmd

    mov     cmd, #$C0
    call    #send_cmd

    mov     cmd, #$DA
    call    #send_cmd

    mov     cmd, #$12
    call    #send_cmd

    mov     cmd, #$81
    call    #send_cmd

    mov     cmd, #$7F
    call    #send_cmd

    mov     cmd, #$20
    call    #send_cmd

    mov     cmd, #$02
    call    #send_cmd

    mov     cmd, #$A4
    call    #send_cmd

    mov     cmd, #$A6
    call    #send_cmd

    mov     cmd, #$8D
    call    #send_cmd

    mov     cmd, #$14
    call    #send_cmd

    mov     cmd, #$AF
    call    #send_cmd

    ret

' =========================
' SEND COMMAND
' =========================

send_cmd

    drvl    #oled_cs
    drvl    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret

' =========================
' SEND DATA
' =========================

send_data

    drvl    #oled_cs
    drvh    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret

' =========================
' SET PAGE POSITION
' =========================

set_pos

    mov     cmd, page
    or      cmd, #$B0
    call    #send_cmd

    mov     cmd, #$00
    call    #send_cmd

    mov     cmd, #$10
    call    #send_cmd

    ret

' =========================
' CLEAR HUB FRAMEBUFFER
' =========================

clear_buffer

    mov     ptr, ##frame_buffer
    mov     count, ##256
    mov     value, #0

clear_buffer_loop

    wrlong  value, ptr
    add     ptr, #4

    djnz    count, #clear_buffer_loop

    ret

' =========================
' PUSH HUB FRAMEBUFFER
' =========================

push_buffer

    ' Read the HUB framebuffer from the end toward the beginning.
    ' Reversing byte order and bit order performs a 180-degree
    ' software rotation while keeping the OLED at $A0 / $C0.

    mov     ptr, ##frame_buffer
    add     ptr, ##1023

    mov     page, #0
    mov     page_count, #8

push_page_loop

    call    #set_pos
    mov     count, #128

push_column_loop

    rdbyte  cmd, ptr
    call    #rotate_display_byte
    call    #send_data

    sub     ptr, #1
    djnz    count, #push_column_loop

    add     page, #1
    djnz    page_count, #push_page_loop

    ret


' =========================
' REVERSE DATA BYTE FOR DISPLAY
'
' $A0/$C0 are kept as the controller's
' normal directions.  The module is mounted
' 180 degrees from the chosen viewing orientation,
' so framebuffer output is rotated in software.
' =========================

rotate_display_byte

    mov     rot_src, cmd
    mov     rot_dst, #0
    mov     rot_count, #8

rotate_display_byte_loop

    shl     rot_dst, #1
    testb   rot_src, #0 wc
if_c or      rot_dst, #1
    shr     rot_src, #1

    djnz    rot_count, #rotate_display_byte_loop

    mov     cmd, rot_dst
    ret

' =========================
' SET PIXEL IN HUB RAM
' =========================

set_pixel

    mov     offset, ypos

    shr     offset, #3
    shl     offset, #7

    add     offset, xpos

    mov     ptr, ##frame_buffer
    add     ptr, offset

    rdbyte  value, ptr

    mov     mask, #1

    mov     temp2, ypos
    and     temp2, #7

    shl     mask, temp2

    or      value, mask

    wrbyte  value, ptr

    ret

' =========================
' SMALL SPARKLE
'
' One pixel.
' =========================

draw_small_sparkle

    mov     xpos, center_x
    mov     ypos, center_y

    call    #set_pixel

    ret

' =========================
' MEDIUM SPARKLE
'
' Five pixels:
'
'    *
'   ***
'    *
' =========================

draw_medium_sparkle

' -------------------------
' CENTER
' -------------------------

    mov     xpos, center_x
    mov     ypos, center_y
    call    #set_pixel

' -------------------------
' LEFT
' -------------------------

    mov     xpos, center_x
    sub     xpos, #1

    mov     ypos, center_y

    call    #set_pixel

' -------------------------
' RIGHT
' -------------------------

    mov     xpos, center_x
    add     xpos, #1

    mov     ypos, center_y

    call    #set_pixel

' -------------------------
' TOP
' -------------------------

    mov     xpos, center_x

    mov     ypos, center_y
    sub     ypos, #1

    call    #set_pixel

' -------------------------
' BOTTOM
' -------------------------

    mov     xpos, center_x

    mov     ypos, center_y
    add     ypos, #1

    call    #set_pixel

    ret

' =========================
' LARGE SPARKLE
'
' Nine pixels:
'
'       *
'       *
'    *  *  *
'       *
'       *
'
' Gives the brightest sparkle
' a larger four-point star.
' =========================

draw_large_sparkle

' -------------------------
' CENTER
' -------------------------

    mov     xpos, center_x
    mov     ypos, center_y

    call    #set_pixel

' -------------------------
' LEFT 1
' -------------------------

    mov     xpos, center_x
    sub     xpos, #1

    mov     ypos, center_y

    call    #set_pixel

' -------------------------
' LEFT 2
' -------------------------

    mov     xpos, center_x
    sub     xpos, #2

    mov     ypos, center_y

    call    #set_pixel

' -------------------------
' RIGHT 1
' -------------------------

    mov     xpos, center_x
    add     xpos, #1

    mov     ypos, center_y

    call    #set_pixel

' -------------------------
' RIGHT 2
' -------------------------

    mov     xpos, center_x
    add     xpos, #2

    mov     ypos, center_y

    call    #set_pixel

' -------------------------
' TOP 1
' -------------------------

    mov     xpos, center_x

    mov     ypos, center_y
    sub     ypos, #1

    call    #set_pixel

' -------------------------
' TOP 2
' -------------------------

    mov     xpos, center_x

    mov     ypos, center_y
    sub     ypos, #2

    call    #set_pixel

' -------------------------
' BOTTOM 1
' -------------------------

    mov     xpos, center_x

    mov     ypos, center_y
    add     ypos, #1

    call    #set_pixel

' -------------------------
' BOTTOM 2
' -------------------------

    mov     xpos, center_x

    mov     ypos, center_y
    add     ypos, #2

    call    #set_pixel

    ret

' =========================
' FRAME DELAY
'
' Sparkles change quickly
' enough to look like twinkling
' instead of slow blinking.
' =========================

frame_delay

    waitx   ##10_000_000

    ret

' =========================
' SOFTWARE SPI
' =========================

spi8

    mov     spi_count, #8

.loop

    testb   cmd, #7 wc
    outc    #oled_mosi

    waitx   ##100

    drvh    #oled_sck
    waitx   ##100

    drvl    #oled_sck
    waitx   ##100

    rol     cmd, #1

    djnz    spi_count, #.loop

    ret

' =========================
' END
' =========================

end

    jmp     #end

' =========================
' VARIABLES
' =========================

cmd             res 1
count           res 1
spi_count       res 1

page            res 1
page_count      res 1

xpos            res 1
ypos            res 1

temp            res 1
temp2           res 1

ptr             res 1
sparkle_ptr     res 1

value           res 1
offset          res 1
mask            res 1

frame_index     res 1

center_x        res 1
center_y        res 1

sparkle_phase   res 1
sparkle_count   res 1

' =========================
' HUB RAM
' =========================


rot_src         res 1
rot_dst         res 1
rot_count       res 1

    orgh

' =========================
' FRAMEBUFFER
'
' 128 x 64 monochrome OLED
'
' 8 pages x 128 bytes
'
' = 1024 bytes
' =========================

frame_buffer

    byte    0[1024]

' =========================
' SPARKLE DATA
'
' Three bytes per sparkle:
'
' X
' Y
' phase
'
' Different phase values make
' the stars twinkle at different
' times.
' =========================

sparkle_data

' X    Y    PHASE

    byte    8,   8,   0
    byte    17,  22,  1
    byte    25,  45,  3
    byte    34,  12,  2

    byte    42,  34,  0
    byte    50,  55,  2
    byte    58,  18,  3
    byte    66,  40,  1

    byte    74,  7,   2
    byte    81,  28,  0
    byte    89,  51,  1
    byte    96,  16,  3

    byte    103, 37,  2
    byte    109,  5,  1
    byte    114, 58,  0
    byte    119, 25,  3

    byte    123, 43,  2
    byte    126, 12,  1