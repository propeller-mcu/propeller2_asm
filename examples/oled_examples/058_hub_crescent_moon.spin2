' =========================================================
'
' P2ASM OLED DEMO 058 / 119
'
' HUB Crescent Moon
'
' Category: HUB RAM Graphics
'
' =========================================================

CON

    _CLKFREQ = 180_000_000

    oled_sck   = 0
    oled_mosi  = 1
    oled_reset = 2
    oled_dc    = 3
    oled_cs    = 4

DAT

    org 0
    asmclk

' -------------------------
' GPIO INIT
' -------------------------

    drvh    #oled_cs
    drvh    #oled_dc
    drvl    #oled_sck
    dirh    #oled_mosi
    dirh    #oled_dc
    dirh    #oled_reset
    dirh    #oled_cs
    dirh    #oled_sck

' =========================
' MAIN
' =========================

main

    call    #reset_oled
    call    #oled_init
    call    #clear_buffer
    call    #draw_hub_crescent_moon
    call    #push_buffer

    jmp     #end

' =========================
' RESET OLED
' =========================

reset_oled

    drvl    #oled_reset
    waitx   ##20_000

    drvh    #oled_reset
    waitx   ##9_000_000

    ret

' =========================
' OLED INIT
' =========================

oled_init

    mov     cmd, #$AE
    call    #send_cmd

    mov     cmd, #$D5
    call    #send_cmd

    mov     cmd, #$80
    call    #send_cmd

    mov     cmd, #$A8
    call    #send_cmd

    mov     cmd, #$3F
    call    #send_cmd

    mov     cmd, #$D3
    call    #send_cmd

    mov     cmd, #0
    call    #send_cmd

    mov     cmd, #$40
    call    #send_cmd

    mov     cmd, #$A0
    call    #send_cmd

    ' Normal COM scan direction.
    '
    ' Y = 0  top
    ' Y = 63 bottom

    mov     cmd, #$C0
    call    #send_cmd

    mov     cmd, #$DA
    call    #send_cmd

    mov     cmd, #$12
    call    #send_cmd

    mov     cmd, #$81
    call    #send_cmd

    mov     cmd, #$7F
    call    #send_cmd

    mov     cmd, #$20
    call    #send_cmd

    mov     cmd, #$02
    call    #send_cmd

    mov     cmd, #$A4
    call    #send_cmd

    mov     cmd, #$A6
    call    #send_cmd

    mov     cmd, #$8D
    call    #send_cmd

    mov     cmd, #$14
    call    #send_cmd

    mov     cmd, #$AF
    call    #send_cmd

    ret

' =========================
' SEND COMMAND
' =========================

send_cmd

    drvl    #oled_cs
    drvl    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret

' =========================
' SEND DATA
' =========================

send_data

    drvl    #oled_cs
    drvh    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret

' =========================
' SET PAGE POSITION
'
' page = 0 through 7
' =========================

set_pos

    mov     cmd, page
    or      cmd, #$B0
    call    #send_cmd

    mov     cmd, #$00
    call    #send_cmd

    mov     cmd, #$10
    call    #send_cmd

    ret

' =========================
' SET X POSITION
'
' xpos = 0 through 127
' =========================

set_xpos

    mov     temp, xpos
    and     temp, #$0F
    mov     cmd, temp
    call    #send_cmd

    mov     temp, xpos
    shr     temp, #4
    and     temp, #$0F
    or      temp, #$10
    mov     cmd, temp
    call    #send_cmd

    ret

' =========================
' CLEAR HUB FRAMEBUFFER
'
' 1024 bytes =
' 256 longwords
' =========================

clear_buffer

    mov     ptr, ##frame_buffer
    mov     count, ##256
    mov     value, #0

clear_buffer_loop

    wrlong  value, ptr
    add     ptr, #4

    djnz    count, #clear_buffer_loop

    ret

' =========================
' PUSH HUB FRAMEBUFFER
'
' Sends all 1024 bytes from
' HUB RAM to the OLED.
' =========================

push_buffer

    ' Read the HUB framebuffer from the end toward the beginning.
    ' Reversing byte order and bit order performs a 180-degree
    ' software rotation while keeping the OLED at $A0 / $C0.

    mov     ptr, ##frame_buffer
    add     ptr, ##1023

    mov     page, #0
    mov     page_count, #8

push_page_loop

    call    #set_pos

    mov     count, #128

push_column_loop

    rdbyte  cmd, ptr
    call    #rotate_display_byte
    call    #send_data

    sub     ptr, #1

    djnz    count, #push_column_loop

    add     page, #1

    djnz    page_count, #push_page_loop

    ret

' =========================
' REVERSE DATA BYTE FOR DISPLAY
'
' $A0/$C0 are kept as the controller's
' normal directions. The module is mounted
' 180 degrees from the chosen viewing orientation,
' so framebuffer output is rotated in software.
' =========================

rotate_display_byte

    mov     rot_src, cmd
    mov     rot_dst, #0
    mov     rot_count, #8

rotate_display_byte_loop

    shl     rot_dst, #1

    testb   rot_src, #0 wc
if_c or    rot_dst, #1

    shr     rot_src, #1

    djnz    rot_count, #rotate_display_byte_loop

    mov     cmd, rot_dst

    ret

' =========================
' SET PIXEL IN HUB RAM
'
' xpos = 0 through 127
' ypos = 0 through 63
' =========================

set_pixel

    mov     offset, ypos
    shr     offset, #3
    shl     offset, #7
    add     offset, xpos

    mov     ptr, ##frame_buffer
    add     ptr, offset

    rdbyte  value, ptr

    mov     mask, #1

    mov     temp, ypos
    and     temp, #7
    shl     mask, temp

    or      value, mask

    wrbyte  value, ptr

    ret

' =========================
' CLEAR PIXEL IN HUB RAM
'
' Turns one framebuffer
' pixel OFF.
' =========================

clear_pixel

    mov     offset, ypos
    shr     offset, #3
    shl     offset, #7
    add     offset, xpos

    mov     ptr, ##frame_buffer
    add     ptr, offset

    rdbyte  value, ptr

    mov     mask, #1

    mov     temp, ypos
    and     temp, #7
    shl     mask, temp

    xor     mask, #$FF
    and     value, mask

    wrbyte  value, ptr

    ret

' =========================
' FILL HORIZONTAL SPAN
'
' span_start = first X
' span_end   = last X
' ypos       = row
' =========================

fill_span

    mov     xpos, span_start

    mov     span_count, span_end
    sub     span_count, span_start
    add     span_count, #1

fill_span_loop

    call    #set_pixel

    add     xpos, #1

    djnz    span_count, #fill_span_loop

    ret

' =========================
' CLEAR HORIZONTAL SPAN
'
' Same idea as fill_span,
' except pixels are turned OFF.
' =========================

clear_span

    mov     xpos, span_start

    mov     span_count, span_end
    sub     span_count, span_start
    add     span_count, #1

clear_span_loop

    call    #clear_pixel

    add     xpos, #1

    djnz    span_count, #clear_span_loop

    ret

' =========================
' HUB CRESCENT MOON
'
' Step 1:
' Draw a filled circle using
' horizontal scanline spans.
'
' Step 2:
' Clear a smaller circle whose
' center is shifted to the right.
'
' The overlap is removed from
' the first circle, leaving a
' crescent.
'
' This demonstrates destructive
' editing of a HUB framebuffer.
' =========================

draw_hub_crescent_moon

' -------------------------
' DRAW OUTER MOON
'
' Center is approximately:
'
' X = 60
' Y = 32
'
' Diameter about 48 pixels.
' -------------------------

    mov     moon_ptr, ##moon_rows
    mov     ypos, #8
    mov     moon_row_count, #49

moon_draw_loop

    rdbyte  span_start, moon_ptr
    add     moon_ptr, #1

    rdbyte  span_end, moon_ptr
    add     moon_ptr, #1

    call    #fill_span

    add     ypos, #1

    djnz    moon_row_count, #moon_draw_loop

' -------------------------
' CUT INNER CIRCLE
'
' This circle is shifted right.
'
' Only rows that intersect the
' outer moon need to be cleared.
' -------------------------

    mov     cut_ptr, ##cut_rows
    mov     ypos, #12
    mov     cut_row_count, #41

moon_cut_loop

    rdbyte  span_start, cut_ptr
    add     cut_ptr, #1

    rdbyte  span_end, cut_ptr
    add     cut_ptr, #1

    call    #clear_span

    add     ypos, #1

    djnz    cut_row_count, #moon_cut_loop

    ret

' =========================
' SOFTWARE SPI
' =========================

spi8

    mov     spi_count, #8

.loop

    testb   cmd, #7 wc
    outc    #oled_mosi

    waitx   ##100

    drvh    #oled_sck

    waitx   ##100

    drvl    #oled_sck

    waitx   ##100

    rol     cmd, #1

    djnz    spi_count, #.loop

    ret

' =========================
' END
' =========================

end

    jmp     #end

' =========================
' VARIABLES
' =========================

cmd             res 1
count           res 1
spi_count       res 1

page            res 1
page_count      res 1

xpos            res 1
ypos            res 1

temp            res 1

ptr             res 1
value           res 1
offset          res 1
mask            res 1

span_start      res 1
span_end        res 1
span_count      res 1

moon_ptr        res 1
cut_ptr         res 1

moon_row_count  res 1
cut_row_count   res 1

' =========================
' HUB RAM FRAMEBUFFER
'
' 128 x 64 monochrome OLED
'
' 8 pages x 128 bytes
' = 1024 bytes
' =========================

rot_src         res 1
rot_dst         res 1
rot_count       res 1

    orgh

frame_buffer

    byte    0[1024]

' =========================
' OUTER MOON SCANLINES
'
' Two bytes per row:
'
' left X, right X
'
' Rows correspond to
' Y = 8 through Y = 56.
' =========================

moon_rows

    ' Y = 8
    byte    57,63

    ' Y = 9
    byte    53,67

    ' Y = 10
    byte    50,70

    ' Y = 11
    byte    48,72

    ' Y = 12
    byte    46,74

    ' Y = 13
    byte    44,76

    ' Y = 14
    byte    43,77

    ' Y = 15
    byte    42,78

    ' Y = 16
    byte    41,79

    ' Y = 17
    byte    40,80

    ' Y = 18
    byte    39,81

    ' Y = 19
    byte    38,82

    ' Y = 20
    byte    38,82

    ' Y = 21
    byte    37,83

    ' Y = 22
    byte    37,83

    ' Y = 23
    byte    36,84

    ' Y = 24
    byte    36,84

    ' Y = 25
    byte    36,84

    ' Y = 26
    byte    35,85

    ' Y = 27
    byte    35,85

    ' Y = 28
    byte    35,85

    ' Y = 29
    byte    35,85

    ' Y = 30
    byte    35,85

    ' Y = 31
    byte    35,85

    ' Y = 32
    byte    35,85

    ' Y = 33
    byte    35,85

    ' Y = 34
    byte    35,85

    ' Y = 35
    byte    35,85

    ' Y = 36
    byte    35,85

    ' Y = 37
    byte    35,85

    ' Y = 38
    byte    35,85

    ' Y = 39
    byte    36,84

    ' Y = 40
    byte    36,84

    ' Y = 41
    byte    36,84

    ' Y = 42
    byte    37,83

    ' Y = 43
    byte    37,83

    ' Y = 44
    byte    38,82

    ' Y = 45
    byte    38,82

    ' Y = 46
    byte    39,81

    ' Y = 47
    byte    40,80

    ' Y = 48
    byte    41,79

    ' Y = 49
    byte    42,78

    ' Y = 50
    byte    43,77

    ' Y = 51
    byte    44,76

    ' Y = 52
    byte    46,74

    ' Y = 53
    byte    48,72

    ' Y = 54
    byte    50,70

    ' Y = 55
    byte    53,67

    ' Y = 56
    byte    57,63

' =========================
' INNER CUTOUT SCANLINES
'
' This smaller circle is
' shifted to the right.
'
' Rows correspond to
' Y = 12 through Y = 52.
'
' Clearing these spans removes
' the right side of the large
' circle and creates a crescent.
' =========================

cut_rows

    ' Y = 12
    byte    46,52

    ' Y = 13
    byte    42,56

    ' Y = 14
    byte    39,59

    ' Y = 15
    byte    37,61

    ' Y = 16
    byte    35,63

    ' Y = 17
    byte    34,64

    ' Y = 18
    byte    32,66

    ' Y = 19
    byte    31,67

    ' Y = 20
    byte    30,68

    ' Y = 21
    byte    29,69

    ' Y = 22
    byte    28,70

    ' Y = 23
    byte    28,70

    ' Y = 24
    byte    27,71

    ' Y = 25
    byte    27,71

    ' Y = 26
    byte    26,72

    ' Y = 27
    byte    26,72

    ' Y = 28
    byte    26,72

    ' Y = 29
    byte    26,72

    ' Y = 30
    byte    25,73

    ' Y = 31
    byte    25,73

    ' Y = 32
    byte    25,73

    ' Y = 33
    byte    25,73

    ' Y = 34
    byte    25,73

    ' Y = 35
    byte    26,72

    ' Y = 36
    byte    26,72

    ' Y = 37
    byte    26,72

    ' Y = 38
    byte    26,72

    ' Y = 39
    byte    27,71

    ' Y = 40
    byte    27,71

    ' Y = 41
    byte    28,70

    ' Y = 42
    byte    28,70

    ' Y = 43
    byte    29,69

    ' Y = 44
    byte    30,68

    ' Y = 45
    byte    31,67

    ' Y = 46
    byte    32,66

    ' Y = 47
    byte    34,64

    ' Y = 48
    byte    35,63

    ' Y = 49
    byte    37,61

    ' Y = 50
    byte    39,59

    ' Y = 51
    byte    42,56

    ' Y = 52
    byte    46,52