' =========================================================
'
' P2ASM OLED DEMO 015 / 119
'
' Filled Diamond
'
' Category: OLED Graphics
'
' =========================================================

CON

    _CLKFREQ = 180_000_000

    oled_sck   = 0
    oled_mosi  = 1
    oled_reset = 2
    oled_dc    = 3
    oled_cs    = 4

DAT

    org 0
    asmclk

' -------------------------
' GPIO INIT
' -------------------------

    drvh    #oled_cs
    drvh    #oled_dc
    drvl    #oled_sck
    dirh    #oled_mosi
    dirh    #oled_dc
    dirh    #oled_reset
    dirh    #oled_cs
    dirh    #oled_sck


' =========================
' MAIN
' =========================

main

    call    #reset_oled
    call    #oled_init
    call    #clear_screen

    ' Draw filled diamond
    '
    ' Top:
    '
    ' X = 64
    ' Y = 16
    '
    ' Right:
    '
    ' X = 80
    ' Y = 32
    '
    ' Bottom:
    '
    ' X = 64
    ' Y = 48
    '
    ' Left:
    '
    ' X = 48
    ' Y = 32
    '
    ' The diamond is filled
    ' one vertical column
    ' at a time.

    call    #fill_diamond

    jmp     #end


' =========================
' RESET OLED
' =========================

reset_oled

    drvl    #oled_reset
    waitx   ##20_000

    drvh    #oled_reset

    ' Give OLED time to stabilize

    waitx   ##9_000_000

    ret


' =========================
' OLED INIT
' =========================

oled_init

    mov     cmd, #$AE        ' Display off
    call    #send_cmd

    mov     cmd, #$D5        ' Display clock
    call    #send_cmd

    mov     cmd, #$80
    call    #send_cmd

    mov     cmd, #$A8        ' Multiplex ratio
    call    #send_cmd

    mov     cmd, #$3F        ' 64 rows
    call    #send_cmd

    mov     cmd, #$D3        ' Display offset
    call    #send_cmd

    mov     cmd, #0
    call    #send_cmd

    mov     cmd, #$40        ' Start line
    call    #send_cmd

    mov     cmd, #$A0        ' Normal segment direction
    call    #send_cmd

    mov     cmd, #$C0        ' Normal COM scan direction
    call    #send_cmd

    mov     cmd, #$DA        ' COM pin config
    call    #send_cmd

    mov     cmd, #$12
    call    #send_cmd

    mov     cmd, #$81        ' Contrast
    call    #send_cmd

    mov     cmd, #$7F
    call    #send_cmd

    mov     cmd, #$20        ' Addressing mode
    call    #send_cmd

    mov     cmd, #$02        ' Page addressing mode
    call    #send_cmd

    mov     cmd, #$A4        ' Use display RAM
    call    #send_cmd

    mov     cmd, #$A6        ' Normal display
    call    #send_cmd

    mov     cmd, #$8D        ' Charge pump
    call    #send_cmd

    mov     cmd, #$14
    call    #send_cmd

    mov     cmd, #$AF        ' Display on
    call    #send_cmd

    ret


' =========================
' SEND COMMAND
' =========================

send_cmd

    drvl    #oled_cs
    drvl    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret


' =========================
' SEND DATA
' =========================

send_data

    drvl    #oled_cs
    drvh    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret


' =========================
' SET PAGE POSITION
' =========================

set_pos

    ' Select page 0-7

    mov     cmd, page
    or      cmd, #$B0
    call    #send_cmd

    ' Column low nibble = 0

    mov     cmd, #$00
    call    #send_cmd

    ' Column high nibble = 0

    mov     cmd, #$10
    call    #send_cmd

    ret


' =========================
' SET X POSITION
'
' xpos = 0 - 127
' =========================

set_xpos

    ' Set low column nibble

    mov     temp, xpos
    and     temp, #$0F

    mov     cmd, temp
    call    #send_cmd

    ' Set high column nibble

    mov     temp, xpos
    shr     temp, #4
    and     temp, #$0F
    or      temp, #$10

    mov     cmd, temp
    call    #send_cmd

    ret


' =========================
' CLEAR SCREEN
'
' 8 pages
' 128 bytes per page
' $00 = 00000000
' =========================

clear_screen

    mov     page, #0

clear_page_loop

    call    #set_pos

    mov     count, #128

clear_column_loop

    mov     cmd, #$00
    call    #send_data

    djnz    count, #clear_column_loop

    add     page, #1

    cmp     page, #8 wz

    if_nz   jmp     #clear_page_loop

    ret


' =========================
' FILL DIAMOND
'
' The diamond is built
' one X column at a time.
'
' X = 48 through 80
'
' At the left point:
'
' Y = 32 through 32
'
' Moving toward the center:
'
' ymin decreases
' ymax increases
'
' At X = 64:
'
' Y = 16 through 48
'
' Moving toward the right:
'
' ymin increases
' ymax decreases
' =========================

fill_diamond

    mov     xpos, #48
    mov     column_count, #33

diamond_column_loop

    ' Determine which half
    ' of the diamond this
    ' column belongs to.
    '
    ' X = 48 through 64
    ' uses the left formula.
    '
    ' X = 65 through 80
    ' uses the right formula.

    cmp     xpos, #65 wc

    if_nc   jmp     #diamond_right_half

diamond_left_half

    ' distance = xpos - 48

    mov     distance, xpos
    sub     distance, #48

    ' ymin = 32 - distance

    mov     ymin, #32
    sub     ymin, distance

    ' ymax = 32 + distance

    mov     ymax, #32
    add     ymax, distance

    jmp     #diamond_have_range

diamond_right_half

    ' distance = 80 - xpos

    mov     distance, #80
    sub     distance, xpos

    ' ymin = 32 - distance

    mov     ymin, #32
    sub     ymin, distance

    ' ymax = 32 + distance

    mov     ymax, #32
    add     ymax, distance

diamond_have_range

    call    #draw_filled_column

    add     xpos, #1

    djnz    column_count, #diamond_column_loop

    ret


' =========================
' DRAW FILLED COLUMN
'
' xpos = X position
' ymin = first Y pixel
' ymax = last Y pixel
'
' The column may cross
' several OLED pages.
'
' For each page we create
' one byte containing all
' pixels between ymin
' and ymax that belong
' to that page.
' =========================

draw_filled_column

    ' Find first page
    '
    ' page = ymin / 8

    mov     page, ymin
    shr     page, #3

    ' Find final page
    '
    ' final_page = ymax / 8

    mov     final_page, ymax
    shr     final_page, #3

filled_column_page_loop

    ' Select current page

    mov     cmd, page
    or      cmd, #$B0
    call    #send_cmd

    ' Move to X position

    call    #set_xpos

    ' Start with all
    ' 8 pixels turned on

    mov     mask, #$FF


    ' -------------------------
    ' FIRST PAGE MASK
    ' -------------------------

    mov     temp, ymin
    shr     temp, #3

    cmp     page, temp wz

    if_nz   jmp     #check_last_page

    ' Find ymin position
    ' inside this page

    mov     temp, ymin
    and     temp, #7

    ' Shift away pixels
    ' below ymin

    mov     mask, #$FF
    shl     mask, temp
    and     mask, #$FF

check_last_page

    ' -------------------------
    ' LAST PAGE MASK
    ' -------------------------

    cmp     page, final_page wz

    if_nz   jmp     #send_column_byte

    ' Find ymax position
    ' inside this page

    mov     temp, ymax
    and     temp, #7
    add     temp, #1

    ' Create:
    '
    ' (1 << temp) - 1

    mov     end_mask, #1
    shl     end_mask, temp
    sub     end_mask, #1

    ' Keep only pixels
    ' through ymax

    and     mask, end_mask

send_column_byte

    mov     cmd, mask
    call    #send_data

    ' Was that the last page?

    cmp     page, final_page wz

    if_z    jmp     #filled_column_done

    add     page, #1

    jmp     #filled_column_page_loop

filled_column_done

    ret


' =========================
' SOFTWARE SPI
'
' Slow / beginner-friendly
' bit-banged SPI timing
' =========================

spi8

    mov     x, #8

.loop

    ' Get bit 7 of cmd

    testb   cmd, #7 wc

    ' Put bit on MOSI

    outc    #oled_mosi

    ' Allow MOSI to settle

    waitx   ##100

    ' Clock HIGH

    drvh    #oled_sck
    waitx   ##100

    ' Clock LOW

    drvl    #oled_sck
    waitx   ##100

    ' Move next bit into bit 7

    rol     cmd, #1

    ' Repeat for 8 bits

    djnz    x, #.loop

    ret


' =========================
' END
' =========================

end

    jmp     #end


' =========================
' VARIABLES
' =========================

cmd           res 1
count         res 1
x             res 1
page          res 1
xpos          res 1
temp          res 1
mask          res 1
column_count  res 1
distance      res 1
ymin          res 1
ymax          res 1
final_page    res 1
end_mask      res 1