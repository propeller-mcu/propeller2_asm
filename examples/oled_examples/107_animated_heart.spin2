' =========================================================
'
' P2ASM OLED DEMO 107 / 119
'
' Animated Heart
'
' Category: HUB RAM Animation
'
' =========================================================

CON

    _CLKFREQ = 180_000_000

    oled_sck   = 0
    oled_mosi  = 1
    oled_reset = 2
    oled_dc    = 3
    oled_cs    = 4

DAT

    org 0
    asmclk

' -------------------------
' GPIO INIT
' -------------------------

    drvh    #oled_cs
    drvh    #oled_dc
    drvl    #oled_sck
    dirh    #oled_mosi
    dirh    #oled_dc
    dirh    #oled_reset
    dirh    #oled_cs
    dirh    #oled_sck

' =========================
' MAIN
' =========================

main

    call    #reset_oled
    call    #oled_init

' =========================
' ANIMATED HEART
'
' The heart alternates between
' two sizes.
'
' SMALL
'
' LARGE
'
' SMALL
'
' LARGE
'
' forever.
'
' Unlike the original point-list
' version, each heart is made
' from solid horizontal spans.
'
' This produces a filled heart
' with no dotted outline.
' =========================

heart_loop

' =========================
' SMALL HEART
' =========================

    call    #clear_buffer

    call    #draw_small_heart

    call    #push_buffer

    call    #small_delay

' =========================
' LARGE HEART
' =========================

    call    #clear_buffer

    call    #draw_large_heart

    call    #push_buffer

    call    #large_delay

    jmp     #heart_loop

' =========================
' SMALL HEART
'
' Centered around:
'
' X = 64
' Y = 34
'
' The heart is built from
' horizontal filled spans.
' =========================

draw_small_heart

' -------------------------
' TOP LOBES
' -------------------------

    mov     xpos, #56
    mov     ypos, #25
    mov     line_count, #6
    call    #draw_hline

    mov     xpos, #66
    mov     ypos, #25
    mov     line_count, #6
    call    #draw_hline

    mov     xpos, #53
    mov     ypos, #26
    mov     line_count, #11
    call    #draw_hline

    mov     xpos, #64
    mov     ypos, #26
    mov     line_count, #11
    call    #draw_hline

    mov     xpos, #52
    mov     ypos, #27
    mov     line_count, #24
    call    #draw_hline

    mov     xpos, #51
    mov     ypos, #28
    mov     line_count, #26
    call    #draw_hline

    mov     xpos, #51
    mov     ypos, #29
    mov     line_count, #26
    call    #draw_hline

    mov     xpos, #51
    mov     ypos, #30
    mov     line_count, #26
    call    #draw_hline

' -------------------------
' BODY
' -------------------------

    mov     xpos, #52
    mov     ypos, #31
    mov     line_count, #24
    call    #draw_hline

    mov     xpos, #52
    mov     ypos, #32
    mov     line_count, #24
    call    #draw_hline

    mov     xpos, #53
    mov     ypos, #33
    mov     line_count, #22
    call    #draw_hline

    mov     xpos, #54
    mov     ypos, #34
    mov     line_count, #20
    call    #draw_hline

    mov     xpos, #55
    mov     ypos, #35
    mov     line_count, #18
    call    #draw_hline

    mov     xpos, #56
    mov     ypos, #36
    mov     line_count, #16
    call    #draw_hline

    mov     xpos, #57
    mov     ypos, #37
    mov     line_count, #14
    call    #draw_hline

    mov     xpos, #58
    mov     ypos, #38
    mov     line_count, #12
    call    #draw_hline

    mov     xpos, #59
    mov     ypos, #39
    mov     line_count, #10
    call    #draw_hline

    mov     xpos, #60
    mov     ypos, #40
    mov     line_count, #8
    call    #draw_hline

    mov     xpos, #61
    mov     ypos, #41
    mov     line_count, #6
    call    #draw_hline

    mov     xpos, #62
    mov     ypos, #42
    mov     line_count, #4
    call    #draw_hline

    mov     xpos, #63
    mov     ypos, #43
    mov     line_count, #2
    call    #draw_hline

    ret

' =========================
' LARGE HEART
'
' Larger pulse frame.
'
' Same basic heart geometry,
' but wider and taller.
' =========================

draw_large_heart

' -------------------------
' TOP LOBES
' -------------------------

    mov     xpos, #53
    mov     ypos, #21
    mov     line_count, #9
    call    #draw_hline

    mov     xpos, #66
    mov     ypos, #21
    mov     line_count, #9
    call    #draw_hline

    mov     xpos, #50
    mov     ypos, #22
    mov     line_count, #14
    call    #draw_hline

    mov     xpos, #64
    mov     ypos, #22
    mov     line_count, #14
    call    #draw_hline

    mov     xpos, #48
    mov     ypos, #23
    mov     line_count, #32
    call    #draw_hline

    mov     xpos, #47
    mov     ypos, #24
    mov     line_count, #34
    call    #draw_hline

    mov     xpos, #46
    mov     ypos, #25
    mov     line_count, #36
    call    #draw_hline

    mov     xpos, #46
    mov     ypos, #26
    mov     line_count, #36
    call    #draw_hline

    mov     xpos, #46
    mov     ypos, #27
    mov     line_count, #36
    call    #draw_hline

    mov     xpos, #47
    mov     ypos, #28
    mov     line_count, #34
    call    #draw_hline

' -------------------------
' BODY
' -------------------------

    mov     xpos, #48
    mov     ypos, #29
    mov     line_count, #32
    call    #draw_hline

    mov     xpos, #49
    mov     ypos, #30
    mov     line_count, #30
    call    #draw_hline

    mov     xpos, #50
    mov     ypos, #31
    mov     line_count, #28
    call    #draw_hline

    mov     xpos, #51
    mov     ypos, #32
    mov     line_count, #26
    call    #draw_hline

    mov     xpos, #52
    mov     ypos, #33
    mov     line_count, #24
    call    #draw_hline

    mov     xpos, #53
    mov     ypos, #34
    mov     line_count, #22
    call    #draw_hline

    mov     xpos, #54
    mov     ypos, #35
    mov     line_count, #20
    call    #draw_hline

    mov     xpos, #55
    mov     ypos, #36
    mov     line_count, #18
    call    #draw_hline

    mov     xpos, #56
    mov     ypos, #37
    mov     line_count, #16
    call    #draw_hline

    mov     xpos, #57
    mov     ypos, #38
    mov     line_count, #14
    call    #draw_hline

    mov     xpos, #58
    mov     ypos, #39
    mov     line_count, #12
    call    #draw_hline

    mov     xpos, #59
    mov     ypos, #40
    mov     line_count, #10
    call    #draw_hline

    mov     xpos, #60
    mov     ypos, #41
    mov     line_count, #8
    call    #draw_hline

    mov     xpos, #61
    mov     ypos, #42
    mov     line_count, #6
    call    #draw_hline

    mov     xpos, #62
    mov     ypos, #43
    mov     line_count, #4
    call    #draw_hline

    mov     xpos, #63
    mov     ypos, #44
    mov     line_count, #2
    call    #draw_hline

    ret

' =========================
' RESET OLED
' =========================

reset_oled

    drvl    #oled_reset
    waitx   ##20_000

    drvh    #oled_reset
    waitx   ##9_000_000

    ret

' =========================
' OLED INIT
' =========================

oled_init

    mov     cmd, #$AE
    call    #send_cmd

    mov     cmd, #$D5
    call    #send_cmd

    mov     cmd, #$80
    call    #send_cmd

    mov     cmd, #$A8
    call    #send_cmd

    mov     cmd, #$3F
    call    #send_cmd

    mov     cmd, #$D3
    call    #send_cmd

    mov     cmd, #0
    call    #send_cmd

    mov     cmd, #$40
    call    #send_cmd

    mov     cmd, #$A0
    call    #send_cmd

    mov     cmd, #$C0
    call    #send_cmd

    mov     cmd, #$DA
    call    #send_cmd

    mov     cmd, #$12
    call    #send_cmd

    mov     cmd, #$81
    call    #send_cmd

    mov     cmd, #$7F
    call    #send_cmd

    mov     cmd, #$20
    call    #send_cmd

    mov     cmd, #$02
    call    #send_cmd

    mov     cmd, #$A4
    call    #send_cmd

    mov     cmd, #$A6
    call    #send_cmd

    mov     cmd, #$8D
    call    #send_cmd

    mov     cmd, #$14
    call    #send_cmd

    mov     cmd, #$AF
    call    #send_cmd

    ret

' =========================
' SEND COMMAND
' =========================

send_cmd

    drvl    #oled_cs
    drvl    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret

' =========================
' SEND DATA
' =========================

send_data

    drvl    #oled_cs
    drvh    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret

' =========================
' SET PAGE POSITION
' =========================

set_pos

    mov     cmd, page
    or      cmd, #$B0

    call    #send_cmd

    mov     cmd, #$00
    call    #send_cmd

    mov     cmd, #$10
    call    #send_cmd

    ret

' =========================
' CLEAR HUB FRAMEBUFFER
' =========================

clear_buffer

    mov     ptr, ##frame_buffer
    mov     count, ##256
    mov     value, #0

clear_buffer_loop

    wrlong  value, ptr

    add     ptr, #4

    djnz    count, #clear_buffer_loop

    ret

' =========================
' PUSH HUB FRAMEBUFFER
' =========================

push_buffer

    ' Read the HUB framebuffer from the end toward the beginning.
    ' Reversing byte order and bit order performs a 180-degree
    ' software rotation while keeping the OLED at $A0 / $C0.

    mov     ptr, ##frame_buffer
    add     ptr, ##1023

    mov     page, #0
    mov     page_count, #8

push_page_loop

    call    #set_pos
    mov     count, #128

push_column_loop

    rdbyte  cmd, ptr
    call    #rotate_display_byte
    call    #send_data

    sub     ptr, #1
    djnz    count, #push_column_loop

    add     page, #1
    djnz    page_count, #push_page_loop

    ret


' =========================
' REVERSE DATA BYTE FOR DISPLAY
'
' $A0/$C0 are kept as the controller's
' normal directions.  The module is mounted
' 180 degrees from the chosen viewing orientation,
' so framebuffer output is rotated in software.
' =========================

rotate_display_byte

    mov     rot_src, cmd
    mov     rot_dst, #0
    mov     rot_count, #8

rotate_display_byte_loop

    shl     rot_dst, #1
    testb   rot_src, #0 wc
if_c or      rot_dst, #1
    shr     rot_src, #1

    djnz    rot_count, #rotate_display_byte_loop

    mov     cmd, rot_dst
    ret

' =========================
' SET PIXEL IN HUB RAM
' =========================

set_pixel

    mov     offset, ypos

    shr     offset, #3
    shl     offset, #7

    add     offset, xpos

    mov     ptr, ##frame_buffer
    add     ptr, offset

    rdbyte  value, ptr

    mov     mask, #1

    mov     temp, ypos
    and     temp, #7

    shl     mask, temp

    or      value, mask

    wrbyte  value, ptr

    ret

' =========================
' DRAW HORIZONTAL LINE
'
' xpos       = starting X
'
' ypos       = Y
'
' line_count = width
' =========================

draw_hline

draw_hline_loop

    call    #set_pixel

    add     xpos, #1

    djnz    line_count, #draw_hline_loop

    ret

' =========================
' SMALL HEART DELAY
'
' Keeping this slightly shorter
' gives the pulse a heartbeat-like
' rhythm.
' =========================

small_delay

    waitx   ##18_000_000

    ret

' =========================
' LARGE HEART DELAY
'
' Hold the expanded heart a
' little longer.
' =========================

large_delay

    waitx   ##24_000_000

    ret

' =========================
' SOFTWARE SPI
' =========================

spi8

    mov     spi_count, #8

.loop

    testb   cmd, #7 wc
    outc    #oled_mosi

    waitx   ##100

    drvh    #oled_sck
    waitx   ##100

    drvl    #oled_sck
    waitx   ##100

    rol     cmd, #1

    djnz    spi_count, #.loop

    ret

' =========================
' END
' =========================

end

    jmp     #end

' =========================
' VARIABLES
' =========================

cmd             res 1
count           res 1
spi_count       res 1

page            res 1
page_count      res 1

xpos            res 1
ypos            res 1

temp            res 1
ptr             res 1

value           res 1
offset          res 1
mask            res 1

line_count      res 1

' =========================
' HUB RAM
' =========================


rot_src         res 1
rot_dst         res 1
rot_count       res 1

    orgh

' =========================
' FRAMEBUFFER
'
' 128 x 64 monochrome OLED
'
' 8 pages x 128 bytes
'
' = 1024 bytes
' =========================

frame_buffer

    byte    0[1024]