' =========================================================
'
' P2ASM OLED DEMO 080 / 119
'
' Shrinking Square
'
' Category: HUB RAM Animation
'
' =========================================================

CON

    _CLKFREQ = 180_000_000

    oled_sck   = 0
    oled_mosi  = 1
    oled_reset = 2
    oled_dc    = 3
    oled_cs    = 4

DAT

    org 0
    asmclk

' -------------------------
' GPIO INIT
' -------------------------

    drvh    #oled_cs
    drvh    #oled_dc
    drvl    #oled_sck
    dirh    #oled_mosi
    dirh    #oled_dc
    dirh    #oled_reset
    dirh    #oled_cs
    dirh    #oled_sck

' =========================
' MAIN
' =========================

main

    call    #reset_oled
    call    #oled_init

    mov     shape_size, #26

animate_square_loop

    call    #clear_buffer

    mov     center_x, #64
    mov     center_y, #32

    call    #draw_square_outline

    call    #push_buffer
    call    #frame_delay

    sub     shape_size, #1

    cmp     shape_size, #2 wc
if_ae jmp  #animate_square_loop

    mov     shape_size, #26

    jmp    #animate_square_loop

' =========================
' RESET OLED
' =========================

reset_oled

    drvl    #oled_reset

    waitx   ##20_000

    drvh    #oled_reset

    waitx   ##9_000_000

    ret

' =========================
' OLED INIT
' =========================

oled_init

    mov     cmd, #$AE
    call    #send_cmd

    mov     cmd, #$D5
    call    #send_cmd

    mov     cmd, #$80
    call    #send_cmd

    mov     cmd, #$A8
    call    #send_cmd

    mov     cmd, #$3F
    call    #send_cmd

    mov     cmd, #$D3
    call    #send_cmd

    mov     cmd, #0
    call    #send_cmd

    mov     cmd, #$40
    call    #send_cmd

    mov     cmd, #$A0
    call    #send_cmd

    mov     cmd, #$C0
    call    #send_cmd

    mov     cmd, #$DA
    call    #send_cmd

    mov     cmd, #$12
    call    #send_cmd

    mov     cmd, #$81
    call    #send_cmd

    mov     cmd, #$7F
    call    #send_cmd

    mov     cmd, #$20
    call    #send_cmd

    mov     cmd, #$02
    call    #send_cmd

    mov     cmd, #$A4
    call    #send_cmd

    mov     cmd, #$A6
    call    #send_cmd

    mov     cmd, #$8D
    call    #send_cmd

    mov     cmd, #$14
    call    #send_cmd

    mov     cmd, #$AF
    call    #send_cmd

    ret

' =========================
' SEND COMMAND
' =========================

send_cmd

    drvl    #oled_cs
    drvl    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret

' =========================
' SEND DATA
' =========================

send_data

    drvl    #oled_cs
    drvh    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret

' =========================
' SET PAGE POSITION
' =========================

set_pos

    mov     cmd, page

    or      cmd, #$B0

    call    #send_cmd

    mov     cmd, #$00

    call    #send_cmd

    mov     cmd, #$10

    call    #send_cmd

    ret

' =========================
' CLEAR HUB FRAMEBUFFER
' =========================

clear_buffer

    mov     ptr, ##frame_buffer

    mov     count, ##256

    mov     value, #0

clear_buffer_loop

    wrlong  value, ptr

    add     ptr, #4

    djnz    count, #clear_buffer_loop

    ret

' =========================
' FILL HUB FRAMEBUFFER
' =========================

fill_buffer

    mov     ptr, ##frame_buffer

    mov     count, ##256

    mov     value, ##$FFFFFFFF

fill_buffer_loop

    wrlong  value, ptr

    add     ptr, #4

    djnz    count, #fill_buffer_loop

    ret

' =========================
' PUSH HUB FRAMEBUFFER
' =========================

push_buffer

    ' Read the HUB framebuffer from the end toward the beginning.
    ' Reversing byte order and bit order performs a 180-degree
    ' software rotation while keeping the OLED at $A0 / $C0.

    mov     ptr, ##frame_buffer

    add     ptr, ##1023

    mov     page, #0

    mov     page_count, #8

push_page_loop

    call    #set_pos

    mov     count, #128

push_column_loop

    rdbyte  cmd, ptr

    call    #rotate_display_byte

    call    #send_data

    sub     ptr, #1

    djnz    count, #push_column_loop

    add     page, #1

    djnz    page_count, #push_page_loop

    ret

' =========================
' REVERSE DATA BYTE FOR DISPLAY
' =========================

rotate_display_byte

    mov     rot_src, cmd

    mov     rot_dst, #0

    mov     rot_count, #8

rotate_display_byte_loop

    shl     rot_dst, #1

    testb   rot_src, #0 wc

if_c or    rot_dst, #1

    shr     rot_src, #1

    djnz    rot_count, #rotate_display_byte_loop

    mov     cmd, rot_dst

    ret

' =========================
' SET PIXEL IN HUB RAM
' =========================

set_pixel

    mov     offset, ypos

    shr     offset, #3

    shl     offset, #7

    add     offset, xpos

    mov     ptr, ##frame_buffer

    add     ptr, offset

    rdbyte  value, ptr

    mov     mask, #1

    mov     temp, ypos

    and     temp, #7

    shl     mask, temp

    or      value, mask

    wrbyte  value, ptr

    ret

' =========================
' DRAW HORIZONTAL LINE
' =========================

draw_hline

draw_hline_loop

    call    #set_pixel

    add     xpos, #1

    djnz    line_count, #draw_hline_loop

    ret

' =========================
' DRAW VERTICAL LINE
' =========================

draw_vline

draw_vline_loop

    call    #set_pixel

    add     ypos, #1

    djnz    line_count, #draw_vline_loop

    ret

' =========================
' DRAW SQUARE OUTLINE
' =========================

draw_square_outline

    mov     xpos, center_x

    sub     xpos, shape_size

    mov     ypos, center_y

    sub     ypos, shape_size

    mov     line_count, shape_size

    shl     line_count, #1

    add     line_count, #1

    call    #draw_hline


    mov     xpos, center_x

    sub     xpos, shape_size

    mov     ypos, center_y

    add     ypos, shape_size

    mov     line_count, shape_size

    shl     line_count, #1

    add     line_count, #1

    call    #draw_hline


    mov     xpos, center_x

    sub     xpos, shape_size

    mov     ypos, center_y

    sub     ypos, shape_size

    mov     line_count, shape_size

    shl     line_count, #1

    add     line_count, #1

    call    #draw_vline


    mov     xpos, center_x

    add     xpos, shape_size

    mov     ypos, center_y

    sub     ypos, shape_size

    mov     line_count, shape_size

    shl     line_count, #1

    add     line_count, #1

    call    #draw_vline

    ret

' =========================
' FRAME DELAY
' =========================

frame_delay

    waitx   ##18_000_000

    ret

' =========================
' SOFTWARE SPI
' =========================

spi8

    mov     spi_count, #8

.loop

    testb   cmd, #7 wc

    outc    #oled_mosi

    waitx   ##100

    drvh    #oled_sck

    waitx   ##100

    drvl    #oled_sck

    waitx   ##100

    rol     cmd, #1

    djnz    spi_count, #.loop

    ret

' =========================
' END
' =========================

end

    jmp     #end

' =========================
' VARIABLES
' =========================

cmd             res 1
count           res 1
spi_count       res 1

page            res 1
page_count      res 1

xpos            res 1
ypos            res 1

temp            res 1
ptr             res 1

value           res 1
offset          res 1
mask            res 1

line_count      res 1

center_x        res 1
center_y        res 1

shape_size      res 1

rot_src         res 1
rot_dst         res 1
rot_count       res 1

orgh

frame_buffer

    byte    0[1024]