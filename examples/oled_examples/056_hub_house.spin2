' =========================================================
'
' P2ASM OLED DEMO 056 / 119
'
' HUB House
'
' Category: HUB RAM Graphics
'
' =========================================================

CON

    _CLKFREQ = 180_000_000

    oled_sck   = 0
    oled_mosi  = 1
    oled_reset = 2
    oled_dc    = 3
    oled_cs    = 4

DAT

    org 0
    asmclk

' -------------------------
' GPIO INIT
' -------------------------

    drvh    #oled_cs
    drvh    #oled_dc
    drvl    #oled_sck
    dirh    #oled_mosi
    dirh    #oled_dc
    dirh    #oled_reset
    dirh    #oled_cs
    dirh    #oled_sck

' =========================
' MAIN
' =========================

main

    call    #reset_oled
    call    #oled_init
    call    #clear_buffer
    call    #draw_hub_house
    call    #push_buffer

    jmp     #end

' =========================
' RESET OLED
' =========================

reset_oled

    drvl    #oled_reset

    waitx   ##20_000

    drvh    #oled_reset

    waitx   ##9_000_000

    ret

' =========================
' OLED INIT
' =========================

oled_init

    mov     cmd, #$AE
    call    #send_cmd

    mov     cmd, #$D5
    call    #send_cmd

    mov     cmd, #$80
    call    #send_cmd

    mov     cmd, #$A8
    call    #send_cmd

    mov     cmd, #$3F
    call    #send_cmd

    mov     cmd, #$D3
    call    #send_cmd

    mov     cmd, #0
    call    #send_cmd

    mov     cmd, #$40
    call    #send_cmd

    mov     cmd, #$A0
    call    #send_cmd

    ' Normal COM scan direction
    ' makes Y = 0 the top of the
    ' framebuffer on this OLED.

    mov     cmd, #$C0
    call    #send_cmd

    mov     cmd, #$DA
    call    #send_cmd

    mov     cmd, #$12
    call    #send_cmd

    mov     cmd, #$81
    call    #send_cmd

    mov     cmd, #$7F
    call    #send_cmd

    mov     cmd, #$20
    call    #send_cmd

    mov     cmd, #$02
    call    #send_cmd

    mov     cmd, #$A4
    call    #send_cmd

    mov     cmd, #$A6
    call    #send_cmd

    mov     cmd, #$8D
    call    #send_cmd

    mov     cmd, #$14
    call    #send_cmd

    mov     cmd, #$AF
    call    #send_cmd

    ret

' =========================
' SEND COMMAND
' =========================

send_cmd

    drvl    #oled_cs
    drvl    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret

' =========================
' SEND DATA
' =========================

send_data

    drvl    #oled_cs
    drvh    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret

' =========================
' SET PAGE POSITION
'
' page = 0 through 7
' =========================

set_pos

    mov     cmd, page
    or      cmd, #$B0
    call    #send_cmd

    mov     cmd, #$00
    call    #send_cmd

    mov     cmd, #$10
    call    #send_cmd

    ret

' =========================
' SET X POSITION
'
' xpos = 0 through 127
' =========================

set_xpos

    mov     temp, xpos
    and     temp, #$0F

    mov     cmd, temp
    call    #send_cmd

    mov     temp, xpos
    shr     temp, #4
    and     temp, #$0F
    or      temp, #$10

    mov     cmd, temp
    call    #send_cmd

    ret

' =========================
' CLEAR HUB FRAMEBUFFER
'
' Clears 1024 bytes in HUB RAM.
' The OLED is not touched here.
' =========================

clear_buffer

    mov     ptr, ##frame_buffer
    mov     count, ##256
    mov     value, #0

clear_buffer_loop

    wrlong  value, ptr

    add     ptr, #4

    djnz    count, #clear_buffer_loop

    ret

' =========================
' PUSH HUB FRAMEBUFFER
'
' Copies all 1024 framebuffer
' bytes from HUB RAM to OLED RAM.
' =========================

push_buffer

    ' Read the HUB framebuffer from the end toward the beginning.
    ' Reversing byte order and bit order performs a 180-degree
    ' software rotation while keeping the OLED at $A0 / $C0.

    mov     ptr, ##frame_buffer
    add     ptr, ##1023

    mov     page, #0
    mov     page_count, #8

push_page_loop

    call    #set_pos

    mov     count, #128

push_column_loop

    rdbyte  cmd, ptr

    call    #rotate_display_byte
    call    #send_data

    sub     ptr, #1

    djnz    count, #push_column_loop

    add     page, #1

    djnz    page_count, #push_page_loop

    ret

' =========================
' REVERSE DATA BYTE FOR DISPLAY
'
' $A0/$C0 are kept as the controller's
' normal directions. The module is mounted
' 180 degrees from the chosen viewing orientation,
' so framebuffer output is rotated in software.
' =========================

rotate_display_byte

    mov     rot_src, cmd
    mov     rot_dst, #0
    mov     rot_count, #8

rotate_display_byte_loop

    shl     rot_dst, #1

    testb   rot_src, #0 wc

if_c    or      rot_dst, #1

    shr     rot_src, #1

    djnz    rot_count, #rotate_display_byte_loop

    mov     cmd, rot_dst

    ret

' =========================
' SET PIXEL IN HUB RAM
'
' xpos = 0 through 127
' ypos = 0 through 63
'
' Y = 0 is the top.
'
' No OLED write occurs here.
' Only frame_buffer is changed.
' =========================

set_pixel

    mov     offset, ypos
    shr     offset, #3
    shl     offset, #7
    add     offset, xpos

    mov     ptr, ##frame_buffer
    add     ptr, offset

    rdbyte  value, ptr

    mov     mask, #1

    mov     temp, ypos
    and     temp, #7

    shl     mask, temp

    or      value, mask

    wrbyte  value, ptr

    ret

' =========================
' CLEAR PIXEL IN HUB RAM
' =========================

clear_pixel

    mov     offset, ypos
    shr     offset, #3
    shl     offset, #7
    add     offset, xpos

    mov     ptr, ##frame_buffer
    add     ptr, offset

    rdbyte  value, ptr

    mov     mask, #1

    mov     temp, ypos
    and     temp, #7

    shl     mask, temp

    xor     mask, ##$FF

    and     value, mask

    wrbyte  value, ptr

    ret

' =========================
' HUB HOUSE
'
' Composite drawing:
'
' walls
' roof
' door
'
' Everything is drawn into one
' HUB framebuffer before the OLED
' receives the finished image.
' =========================

draw_hub_house

' -------------------------
' WALL OUTLINE
'
' Main wall area:
'
' X = 40 through 87
' Y = 30 through 53
' -------------------------

    mov     ypos, #30
    mov     row_count, #24

house_wall_row

    mov     xpos, #40
    mov     column_count, #48

house_wall_pixel

    call    #set_pixel

    add     xpos, #1

    djnz    column_count, #house_wall_pixel

    add     ypos, #1

    djnz    row_count, #house_wall_row

' -------------------------
' CLEAR WALL INTERIOR
'
' Leaves a 2-pixel outline.
' -------------------------

    mov     ypos, #32
    mov     row_count, #20

house_clear_row

    mov     xpos, #42
    mov     column_count, #44

house_clear_pixel

    call    #clear_pixel

    add     xpos, #1

    djnz    column_count, #house_clear_pixel

    add     ypos, #1

    djnz    row_count, #house_clear_row

' -------------------------
' LEFT ROOF
'
' Starts at left wall and climbs
' upward toward the roof peak.
' -------------------------

    mov     xpos, #40
    mov     ypos, #30
    mov     step_count, #25

roof_left

    call    #set_pixel

    add     xpos, #1
    sub     ypos, #1

    djnz    step_count, #roof_left

' -------------------------
' RIGHT ROOF
'
' Starts at the peak and slopes
' downward toward the right wall.
' -------------------------

    mov     xpos, #64
    mov     ypos, #6
    mov     step_count, #25

roof_right

    call    #set_pixel

    add     xpos, #1
    add     ypos, #1

    djnz    step_count, #roof_right

' -------------------------
' DOOR
'
' X = 60 through 67
' Y = 42 through 53
' -------------------------

    mov     ypos, #42
    mov     row_count, #12

door_row

    mov     xpos, #60
    mov     column_count, #8

door_pixel

    call    #set_pixel

    add     xpos, #1

    djnz    column_count, #door_pixel

    add     ypos, #1

    djnz    row_count, #door_row

    ret

' =========================
' SOFTWARE SPI
' =========================

spi8

    mov     spi_count, #8

.loop

    testb   cmd, #7 wc

    outc    #oled_mosi

    waitx   ##100

    drvh    #oled_sck

    waitx   ##100

    drvl    #oled_sck

    waitx   ##100

    rol     cmd, #1

    djnz    spi_count, #.loop

    ret

' =========================
' END
' =========================

end

    jmp     #end

' =========================
' VARIABLES
' =========================

cmd          res 1
count        res 1
spi_count    res 1
page         res 1
page_count   res 1
xpos         res 1
ypos         res 1
temp         res 1
ptr          res 1
value        res 1
offset       res 1
mask         res 1
row_count    res 1
column_count res 1
step_count   res 1

rot_src      res 1
rot_dst      res 1
rot_count    res 1

' =========================
' HUB RAM FRAMEBUFFER
'
' 128 x 64 monochrome OLED
'
' 8 pages x 128 bytes
' = 1024 bytes
' =========================

    orgh

frame_buffer

    byte    0[1024]