' =========================================================
'
' P2ASM OLED DEMO 060 / 119
'
' HUB Concentric Rectangles
'
' Category: HUB RAM Graphics
'
' =========================================================

CON

    _CLKFREQ = 180_000_000

    oled_sck   = 0
    oled_mosi  = 1
    oled_reset = 2
    oled_dc    = 3
    oled_cs    = 4

DAT

    org 0
    asmclk

' -------------------------
' GPIO INIT
' -------------------------

    drvh    #oled_cs
    drvh    #oled_dc
    drvl    #oled_sck
    dirh    #oled_mosi
    dirh    #oled_dc
    dirh    #oled_reset
    dirh    #oled_cs
    dirh    #oled_sck

' =========================
' MAIN
' =========================

main

    call    #reset_oled
    call    #oled_init
    call    #clear_buffer
    call    #draw_hub_concentric_rectangles
    call    #push_buffer

    jmp     #end

' =========================
' RESET OLED
' =========================

reset_oled

    drvl    #oled_reset
    waitx   ##20_000

    drvh    #oled_reset
    waitx   ##9_000_000

    ret

' =========================
' OLED INIT
' =========================

oled_init

    mov     cmd, #$AE
    call    #send_cmd

    mov     cmd, #$D5
    call    #send_cmd

    mov     cmd, #$80
    call    #send_cmd

    mov     cmd, #$A8
    call    #send_cmd

    mov     cmd, #$3F
    call    #send_cmd

    mov     cmd, #$D3
    call    #send_cmd

    mov     cmd, #0
    call    #send_cmd

    mov     cmd, #$40
    call    #send_cmd

    mov     cmd, #$A0
    call    #send_cmd

    mov     cmd, #$C0
    call    #send_cmd

    mov     cmd, #$DA
    call    #send_cmd

    mov     cmd, #$12
    call    #send_cmd

    mov     cmd, #$81
    call    #send_cmd

    mov     cmd, #$7F
    call    #send_cmd

    mov     cmd, #$20
    call    #send_cmd

    mov     cmd, #$02
    call    #send_cmd

    mov     cmd, #$A4
    call    #send_cmd

    mov     cmd, #$A6
    call    #send_cmd

    mov     cmd, #$8D
    call    #send_cmd

    mov     cmd, #$14
    call    #send_cmd

    mov     cmd, #$AF
    call    #send_cmd

    ret

' =========================
' SEND COMMAND
' =========================

send_cmd

    drvl    #oled_cs
    drvl    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret

' =========================
' SEND DATA
' =========================

send_data

    drvl    #oled_cs
    drvh    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret

' =========================
' SET PAGE POSITION
'
' page = 0 through 7
' =========================

set_pos

    mov     cmd, page
    or      cmd, #$B0
    call    #send_cmd

    mov     cmd, #$00
    call    #send_cmd

    mov     cmd, #$10
    call    #send_cmd

    ret

' =========================
' SET X POSITION
'
' xpos = 0 through 127
' =========================

set_xpos

    mov     temp, xpos
    and     temp, #$0F
    mov     cmd, temp
    call    #send_cmd

    mov     temp, xpos
    shr     temp, #4
    and     temp, #$0F
    or      temp, #$10
    mov     cmd, temp
    call    #send_cmd

    ret

' =========================
' CLEAR HUB FRAMEBUFFER
'
' Clears 1024 bytes in HUB RAM.
' The OLED is not touched here.
' =========================

clear_buffer

    mov     ptr, ##frame_buffer
    mov     count, ##256
    mov     value, #0

clear_buffer_loop

    wrlong  value, ptr

    add     ptr, #4

    djnz    count, #clear_buffer_loop

    ret

' =========================
' PUSH HUB FRAMEBUFFER
'
' Copies all 1024 framebuffer
' bytes from HUB RAM to OLED RAM.
' =========================

push_buffer

    ' Read the HUB framebuffer from the end toward the beginning.
    ' Reversing byte order and bit order performs a 180-degree
    ' software rotation while keeping the OLED at $A0 / $C0.

    mov     ptr, ##frame_buffer
    add     ptr, ##1023

    mov     page, #0
    mov     page_count, #8

push_page_loop

    call    #set_pos

    mov     count, #128

push_column_loop

    rdbyte  cmd, ptr

    call    #rotate_display_byte
    call    #send_data

    sub     ptr, #1

    djnz    count, #push_column_loop

    add     page, #1

    djnz    page_count, #push_page_loop

    ret

' =========================
' REVERSE DATA BYTE FOR DISPLAY
'
' $A0/$C0 are kept as the controller's
' normal directions. The module is mounted
' 180 degrees from the chosen viewing orientation,
' so framebuffer output is rotated in software.
' =========================

rotate_display_byte

    mov     rot_src, cmd
    mov     rot_dst, #0
    mov     rot_count, #8

rotate_display_byte_loop

    shl     rot_dst, #1

    testb   rot_src, #0 wc
if_c or    rot_dst, #1

    shr     rot_src, #1

    djnz    rot_count, #rotate_display_byte_loop

    mov     cmd, rot_dst

    ret

' =========================
' SET PIXEL IN HUB RAM
'
' xpos = 0 through 127
' ypos = 0 through 63
'
' No OLED write occurs here.
' We only modify frame_buffer.
' =========================

set_pixel

    mov     offset, ypos
    shr     offset, #3
    shl     offset, #7
    add     offset, xpos

    mov     ptr, ##frame_buffer
    add     ptr, offset

    rdbyte  value, ptr

    mov     mask, #1

    mov     temp, ypos
    and     temp, #7
    shl     mask, temp

    or      value, mask

    wrbyte  value, ptr

    ret

' =========================
' HUB CONCENTRIC RECTANGLES
' =========================

draw_hub_concentric_rectangles

    mov     inset, #0
    mov     shape_count, #5

concentric_rect_loop

    mov     xpos, #24
    add     xpos, inset

    mov     ypos, #8
    add     ypos, inset

    mov     width, #80

    mov     temp2, inset
    shl     temp2, #1
    sub     width, temp2

    mov     height, #48
    sub     height, temp2

    call    #draw_one_rectangle

    add     inset, #4

    djnz    shape_count, #concentric_rect_loop

    ret

' =========================
' DRAW ONE RECTANGLE
'
' xpos   = left edge
' ypos   = top edge
' width  = rectangle width
' height = rectangle height
' =========================

draw_one_rectangle

    mov     start_x, xpos
    mov     start_y, ypos

' -------------------------
' TOP EDGE
' -------------------------

    mov     line_count, width

rect_top

    call    #set_pixel

    add     xpos, #1

    djnz    line_count, #rect_top

' -------------------------
' BOTTOM EDGE
' -------------------------

    mov     xpos, start_x
    mov     ypos, start_y

    add     ypos, height
    sub     ypos, #1

    mov     line_count, width

rect_bottom

    call    #set_pixel

    add     xpos, #1

    djnz    line_count, #rect_bottom

' -------------------------
' LEFT EDGE
' -------------------------

    mov     xpos, start_x
    mov     ypos, start_y

    mov     line_count, height

rect_left

    call    #set_pixel

    add     ypos, #1

    djnz    line_count, #rect_left

' -------------------------
' RIGHT EDGE
' -------------------------

    mov     xpos, start_x

    add     xpos, width
    sub     xpos, #1

    mov     ypos, start_y

    mov     line_count, height

rect_right

    call    #set_pixel

    add     ypos, #1

    djnz    line_count, #rect_right

    ret

' =========================
' SOFTWARE SPI
' =========================

spi8

    mov     spi_count, #8

.loop

    testb   cmd, #7 wc

    outc    #oled_mosi

    waitx   ##100

    drvh    #oled_sck

    waitx   ##100

    drvl    #oled_sck

    waitx   ##100

    rol     cmd, #1

    djnz    spi_count, #.loop

    ret

' =========================
' END
' =========================

end

    jmp     #end

' =========================
' VARIABLES
' =========================

cmd          res 1
count        res 1
spi_count    res 1

page         res 1
page_count   res 1

xpos         res 1
ypos         res 1

temp         res 1

ptr          res 1

value        res 1
offset       res 1
mask         res 1

inset        res 1
shape_count  res 1

width        res 1
height       res 1

start_x      res 1
start_y      res 1

line_count   res 1
temp2        res 1

' =========================
' HUB RAM FRAMEBUFFER
'
' 128 x 64 monochrome OLED
'
' 8 pages x 128 bytes
' = 1024 bytes
' =========================

rot_src      res 1
rot_dst      res 1
rot_count    res 1

    orgh

frame_buffer

    byte    0[1024]