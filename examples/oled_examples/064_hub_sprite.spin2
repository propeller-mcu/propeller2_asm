' =========================================================
'
' P2ASM OLED DEMO 064 / 119
'
' HUB Sprite
'
' Category: HUB RAM Graphics
'
' =========================================================

CON

    _CLKFREQ = 180_000_000

    oled_sck   = 0
    oled_mosi  = 1
    oled_reset = 2
    oled_dc    = 3
    oled_cs    = 4

DAT

    org 0
    asmclk

' -------------------------
' GPIO INIT
' -------------------------

    drvh    #oled_cs
    drvh    #oled_dc
    drvl    #oled_sck
    dirh    #oled_mosi
    dirh    #oled_dc
    dirh    #oled_reset
    dirh    #oled_cs
    dirh    #oled_sck

' =========================
' MAIN
' =========================

main

    call    #reset_oled
    call    #oled_init
    call    #clear_buffer

    mov     sprite_x, #60
    mov     sprite_page, #3

    call    #blit_sprite
    call    #push_buffer

    jmp     #end

' =========================
' RESET OLED
' =========================

reset_oled

    drvl    #oled_reset

    waitx   ##20_000

    drvh    #oled_reset

    waitx   ##9_000_000

    ret

' =========================
' OLED INIT
' =========================

oled_init

    mov     cmd, #$AE
    call    #send_cmd

    mov     cmd, #$D5
    call    #send_cmd

    mov     cmd, #$80
    call    #send_cmd

    mov     cmd, #$A8
    call    #send_cmd

    mov     cmd, #$3F
    call    #send_cmd

    mov     cmd, #$D3
    call    #send_cmd

    mov     cmd, #0
    call    #send_cmd

    mov     cmd, #$40
    call    #send_cmd

    mov     cmd, #$A0
    call    #send_cmd

    mov     cmd, #$C0
    call    #send_cmd

    mov     cmd, #$DA
    call    #send_cmd

    mov     cmd, #$12
    call    #send_cmd

    mov     cmd, #$81
    call    #send_cmd

    mov     cmd, #$7F
    call    #send_cmd

    mov     cmd, #$20
    call    #send_cmd

    mov     cmd, #$02
    call    #send_cmd

    mov     cmd, #$A4
    call    #send_cmd

    mov     cmd, #$A6
    call    #send_cmd

    mov     cmd, #$8D
    call    #send_cmd

    mov     cmd, #$14
    call    #send_cmd

    mov     cmd, #$AF
    call    #send_cmd

    ret

' =========================
' SEND COMMAND
' =========================

send_cmd

    drvl    #oled_cs
    drvl    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret

' =========================
' SEND DATA
' =========================

send_data

    drvl    #oled_cs
    drvh    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret

' =========================
' SET PAGE POSITION
'
' page = 0 through 7
' =========================

set_pos

    mov     cmd, page
    or      cmd, #$B0

    call    #send_cmd

    mov     cmd, #$00
    call    #send_cmd

    mov     cmd, #$10
    call    #send_cmd

    ret

' =========================
' SET X POSITION
'
' xpos = 0 through 127
' =========================

set_xpos

    mov     temp, xpos
    and     temp, #$0F

    mov     cmd, temp
    call    #send_cmd

    mov     temp, xpos
    shr     temp, #4
    and     temp, #$0F
    or      temp, #$10

    mov     cmd, temp
    call    #send_cmd

    ret

' =========================
' CLEAR HUB FRAMEBUFFER
'
' Clears 1024 bytes in HUB RAM.
' The OLED is not touched here.
' =========================

clear_buffer

    mov     ptr, ##frame_buffer
    mov     count, ##256
    mov     value, #0

clear_buffer_loop

    wrlong  value, ptr

    add     ptr, #4

    djnz    count, #clear_buffer_loop

    ret

' =========================
' PUSH HUB FRAMEBUFFER
'
' Copies all 1024 framebuffer
' bytes from HUB RAM to OLED RAM.
' =========================

push_buffer

    ' Read the HUB framebuffer
    ' from the end toward the
    ' beginning.
    '
    ' Reversing byte order and
    ' bit order performs a
    ' 180-degree software rotation
    ' while keeping the OLED at
    ' $A0 / $C0.

    mov     ptr, ##frame_buffer
    add     ptr, ##1023

    mov     page, #0
    mov     page_count, #8

push_page_loop

    call    #set_pos

    mov     count, #128

push_column_loop

    rdbyte  cmd, ptr

    call    #rotate_display_byte
    call    #send_data

    sub     ptr, #1

    djnz    count, #push_column_loop

    add     page, #1

    djnz    page_count, #push_page_loop

    ret

' =========================
' REVERSE DATA BYTE
' FOR DISPLAY
'
' $A0/$C0 are kept as the
' controller's normal directions.
'
' The module is mounted
' 180 degrees from the chosen
' viewing orientation, so the
' framebuffer output is rotated
' in software.
' =========================

rotate_display_byte

    mov     rot_src, cmd
    mov     rot_dst, #0
    mov     rot_count, #8

rotate_display_byte_loop

    shl     rot_dst, #1

    testb   rot_src, #0 wc

if_c or    rot_dst, #1

    shr     rot_src, #1

    djnz    rot_count, #rotate_display_byte_loop

    mov     cmd, rot_dst

    ret

' =========================
' BLIT 8 X 8 SPRITE
'
' sprite_page = destination page
' sprite_x    = destination X
'
' Each sprite byte represents
' one vertical 8-pixel column.
'
' Since the sprite is exactly
' one OLED page tall, the copy
' can be performed as eight
' consecutive framebuffer bytes.
' =========================

blit_sprite

    ' Calculate framebuffer
    ' destination offset:
    '
    ' sprite_page * 128
    ' + sprite_x

    mov     offset, sprite_page
    shl     offset, #7
    add     offset, sprite_x

    ' Point to destination
    ' in framebuffer.

    mov     ptr, ##frame_buffer
    add     ptr, offset

    ' Point to sprite data.

    mov     source_ptr, ##sprite_image

    ' Sprite is 8 pixels wide.

    mov     count, #8

sprite_blit_loop

    ' Read one vertical
    ' sprite column.

    rdbyte  value, source_ptr

    ' Copy it directly into
    ' the framebuffer.

    wrbyte  value, ptr

    ' Advance both pointers.

    add     source_ptr, #1
    add     ptr, #1

    djnz    count, #sprite_blit_loop

    ret

' =========================
' SOFTWARE SPI
' =========================

spi8

    mov     spi_count, #8

.loop

    testb   cmd, #7 wc

    outc    #oled_mosi

    waitx   ##100

    drvh    #oled_sck

    waitx   ##100

    drvl    #oled_sck

    waitx   ##100

    rol     cmd, #1

    djnz    spi_count, #.loop

    ret

' =========================
' END
' =========================

end

    jmp     #end

' =========================
' VARIABLES
' =========================

cmd             res 1
count           res 1
spi_count       res 1

page            res 1
page_count      res 1

xpos            res 1
ypos            res 1

temp            res 1

ptr             res 1
source_ptr      res 1

value           res 1
offset          res 1
mask            res 1

sprite_x        res 1
sprite_page     res 1

' =========================
' HUB RAM
' =========================

rot_src         res 1
rot_dst         res 1
rot_count       res 1

    orgh

' =========================
' HUB RAM FRAMEBUFFER
'
' 128 x 64 monochrome OLED
'
' 8 pages x 128 bytes
'
' = 1024 bytes
' =========================

frame_buffer

    byte    0[1024]

' =========================
' 8 X 8 SPRITE
'
' Each byte is one vertical
' 8-pixel column.
'
' Eight bytes:
'
' = 8 columns
' x 8 pixels
'
' = 8 x 8 sprite
'
' Pattern:
'
'     .####..
'    #....#.
'   #.#..#.#
'   #......#
'   #......#
'   #.#..#.#
'    #....#.
'     .####..
'
' The sprite data stays in
' HUB RAM and can be copied
' anywhere in the framebuffer
' by changing sprite_x and
' sprite_page.
' =========================

sprite_image

    byte    $3C,$42,$A5,$81
    byte    $81,$A5,$42,$3C