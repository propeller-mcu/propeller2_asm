' =========================================================
'
' P2ASM OLED DEMO 069 / 119
'
' HUB Partial Screen Update
'
' Category: HUB RAM Graphics
'
' =========================================================

CON

    _CLKFREQ = 180_000_000

    oled_sck   = 0
    oled_mosi  = 1
    oled_reset = 2
    oled_dc    = 3
    oled_cs    = 4

DAT

    org 0
    asmclk

' -------------------------
' GPIO INIT
' -------------------------

    drvh    #oled_cs
    drvh    #oled_dc
    drvl    #oled_sck
    dirh    #oled_mosi
    dirh    #oled_dc
    dirh    #oled_reset
    dirh    #oled_cs
    dirh    #oled_sck

' =========================
' MAIN
' =========================

main

    call    #reset_oled
    call    #oled_init

    call    #clear_buffer

    ' Draw a filled rectangle
    ' into the HUB framebuffer.

    call    #draw_hub_filled_rectangle

    ' Only transfer the portion
    ' of the framebuffer that
    ' contains the rectangle.

    call    #push_partial_buffer

    jmp     #end

' =========================
' RESET OLED
' =========================

reset_oled

    drvl    #oled_reset

    waitx   ##20_000

    drvh    #oled_reset

    waitx   ##9_000_000

    ret

' =========================
' OLED INIT
' =========================

oled_init

    mov     cmd, #$AE
    call    #send_cmd

    mov     cmd, #$D5
    call    #send_cmd

    mov     cmd, #$80
    call    #send_cmd

    mov     cmd, #$A8
    call    #send_cmd

    mov     cmd, #$3F
    call    #send_cmd

    mov     cmd, #$D3
    call    #send_cmd

    mov     cmd, #0
    call    #send_cmd

    mov     cmd, #$40
    call    #send_cmd

    mov     cmd, #$A0
    call    #send_cmd

    mov     cmd, #$C0
    call    #send_cmd

    mov     cmd, #$DA
    call    #send_cmd

    mov     cmd, #$12
    call    #send_cmd

    mov     cmd, #$81
    call    #send_cmd

    mov     cmd, #$7F
    call    #send_cmd

    mov     cmd, #$20
    call    #send_cmd

    mov     cmd, #$02
    call    #send_cmd

    mov     cmd, #$A4
    call    #send_cmd

    mov     cmd, #$A6
    call    #send_cmd

    mov     cmd, #$8D
    call    #send_cmd

    mov     cmd, #$14
    call    #send_cmd

    mov     cmd, #$AF
    call    #send_cmd

    ret

' =========================
' SEND COMMAND
' =========================

send_cmd

    drvl    #oled_cs
    drvl    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret

' =========================
' SEND DATA
' =========================

send_data

    drvl    #oled_cs
    drvh    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret

' =========================
' SET PAGE POSITION
'
' page = 0 through 7
' =========================

set_pos

    mov     cmd, page
    or      cmd, #$B0

    call    #send_cmd

    mov     cmd, #$00
    call    #send_cmd

    mov     cmd, #$10
    call    #send_cmd

    ret

' =========================
' SET X POSITION
'
' xpos = 0 through 127
' =========================

set_xpos

    mov     temp, xpos
    and     temp, #$0F

    mov     cmd, temp
    call    #send_cmd

    mov     temp, xpos
    shr     temp, #4
    and     temp, #$0F
    or      temp, #$10

    mov     cmd, temp
    call    #send_cmd

    ret

' =========================
' CLEAR HUB FRAMEBUFFER
'
' Clears 1024 bytes in HUB RAM.
'
' The OLED is not changed here.
' =========================

clear_buffer

    mov     ptr, ##frame_buffer
    mov     count, ##256
    mov     value, #0

clear_buffer_loop

    wrlong  value, ptr

    add     ptr, #4

    djnz    count, #clear_buffer_loop

    ret

' =========================
' SET PIXEL IN HUB RAM
'
' xpos = 0 through 127
' ypos = 0 through 63
'
' The framebuffer address is:
'
' page * 128 + X
'
' where:
'
' page = Y / 8
' =========================

set_pixel

    ' Determine OLED page.

    mov     offset, ypos
    shr     offset, #3

    ' Multiply page by 128.

    shl     offset, #7

    ' Add X position.

    add     offset, xpos

    ' Locate framebuffer byte.

    mov     ptr, ##frame_buffer
    add     ptr, offset

    ' Read existing byte.

    rdbyte  value, ptr

    ' Build bit mask for
    ' Y position inside page.

    mov     mask, #1

    mov     temp, ypos
    and     temp, #7

    shl     mask, temp

    ' Preserve existing pixels
    ' and switch this pixel on.

    or      value, mask

    wrbyte  value, ptr

    ret

' =========================
' HUB FILLED RECTANGLE
'
' Rectangle:
'
' X = 30 through 97
'
' Y = 18 through 45
'
' Width  = 68 pixels
' Height = 28 pixels
'
' Nested loops fill the
' rectangle one pixel at
' a time in HUB RAM.
' =========================

draw_hub_filled_rectangle

    mov     ypos, #18

    mov     row_count, #28

filled_rect_row_loop

    mov     xpos, #30

    mov     column_count, #68

filled_rect_column_loop

    call    #set_pixel

    add     xpos, #1

    djnz    column_count, #filled_rect_column_loop

    add     ypos, #1

    djnz    row_count, #filled_rect_row_loop

    ret

' =========================
' PUSH PARTIAL BUFFER
'
' Instead of sending all:
'
' 1024 bytes
'
' only a centered region is
' copied to OLED RAM.
'
' Destination:
'
' X = 32 through 95
'
' Pages = 2 through 5
'
' Width:
'
' 64 bytes
'
' Height:
'
' 4 OLED pages
'
' Total transfer:
'
' 64 x 4
'
' = 256 display bytes
'
' This is only one quarter
' of a full-screen refresh.
' =========================

push_partial_buffer

    ' The destination region
    ' occupies pages 2 through 5.

    mov     page, #2

    ' Because framebuffer output
    ' is rotated 180 degrees in
    ' software, destination page 2
    ' reads source page 5 first.

    mov     source_page, #5

    mov     page_count, #4

partial_page_loop

    ' Select destination page.

    mov     cmd, page
    or      cmd, #$B0

    call    #send_cmd

    ' Start OLED write at X = 32.

    mov     xpos, #32

    call    #set_xpos

    ' Calculate:
    '
    ' source_page * 128
    '
    ' then begin at X = 95.
    '
    ' Reading backward sends:
    '
    ' 95,94,93 ... 32

    mov     offset, source_page

    shl     offset, #7

    add     offset, #95

    mov     ptr, ##frame_buffer
    add     ptr, offset

    ' 64 columns:
    '
    ' X = 32 through 95

    mov     count, #64

partial_column_loop

    rdbyte  cmd, ptr

    ' Reverse the eight vertical
    ' pixel bits for the software
    ' 180-degree rotation.

    call    #rotate_display_byte

    call    #send_data

    ' Move backward through
    ' source columns.

    sub     ptr, #1

    djnz    count, #partial_column_loop

    ' Advance destination page.

    add     page, #1

    ' Move backward through
    ' source pages.

    sub     source_page, #1

    djnz    page_count, #partial_page_loop

    ret

' =========================
' REVERSE DATA BYTE
' FOR DISPLAY
'
' $A0 / $C0 remain configured
' as the controller's normal
' directions.
'
' The physical display is
' viewed 180 degrees from that
' orientation, so framebuffer
' output is rotated in software.
'
' Full 180-degree rotation
' requires:
'
' 1. Reverse byte order
'
' 2. Reverse bit order
' =========================

rotate_display_byte

    mov     rot_src, cmd
    mov     rot_dst, #0
    mov     rot_count, #8

rotate_display_byte_loop

    shl     rot_dst, #1

    testb   rot_src, #0 wc

if_c or    rot_dst, #1

    shr     rot_src, #1

    djnz    rot_count, #rotate_display_byte_loop

    mov     cmd, rot_dst

    ret

' =========================
' SOFTWARE SPI
'
' Slow / beginner-friendly
' bit-banged SPI.
' =========================

spi8

    mov     spi_count, #8

.loop

    testb   cmd, #7 wc

    outc    #oled_mosi

    waitx   ##100

    drvh    #oled_sck

    waitx   ##100

    drvl    #oled_sck

    waitx   ##100

    rol     cmd, #1

    djnz    spi_count, #.loop

    ret

' =========================
' END
' =========================

end

    jmp     #end

' =========================
' VARIABLES
' =========================

cmd             res 1
count           res 1
spi_count       res 1

page            res 1
page_count      res 1
source_page     res 1

xpos            res 1
ypos            res 1

temp            res 1

ptr             res 1
value           res 1

offset          res 1
mask            res 1

row_count       res 1
column_count    res 1

rot_src         res 1
rot_dst         res 1
rot_count       res 1

    orgh

' =========================
' HUB RAM FRAMEBUFFER
'
' 128 x 64 monochrome OLED
'
' 8 pages x 128 bytes
'
' =
'
' 1024 bytes
' =========================

frame_buffer

    byte    0[1024]