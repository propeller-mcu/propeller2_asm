' =========================================================
'
' P2ASM OLED DEMO 103 / 119
'
' Rotating Line
'
' Category: HUB RAM Animation
'
' =========================================================

CON

    _CLKFREQ = 180_000_000

    oled_sck   = 0
    oled_mosi  = 1
    oled_reset = 2
    oled_dc    = 3
    oled_cs    = 4

DAT

    org 0
    asmclk

' -------------------------
' GPIO INIT
' -------------------------

    drvh    #oled_cs
    drvh    #oled_dc
    drvl    #oled_sck
    dirh    #oled_mosi
    dirh    #oled_dc
    dirh    #oled_reset
    dirh    #oled_cs
    dirh    #oled_sck

' =========================
' MAIN
' =========================

main

    call    #reset_oled
    call    #oled_init

    mov     frame_index, #0

' =========================
' ROTATING LINE
'
' Eight endpoints are stored
' in HUB RAM.
'
' Every frame:
'
' 1. Clear framebuffer
' 2. Read one endpoint
' 3. Draw a solid line from
'    center to endpoint
' 4. Push framebuffer
' 5. Move to next endpoint
'
' After frame 7, the animation
' wraps back to frame 0.
'
' This produces continuous
' rotation forever.
' =========================

rotating_line_loop

    call    #clear_buffer

' -------------------------
' START POINT
'
' Center of screen
' -------------------------

    mov     x1, #64
    mov     y1, #32

' -------------------------
' FIND ENDPOINT
'
' Two bytes per endpoint:
'
' X
' Y
'
' offset = frame_index * 2
' -------------------------

    mov     point_ptr, ##line_endpoints

    mov     temp, frame_index
    shl     temp, #1

    add     point_ptr, temp

' -------------------------
' READ END X
' -------------------------

    rdbyte  x2, point_ptr
    add     point_ptr, #1

' -------------------------
' READ END Y
' -------------------------

    rdbyte  y2, point_ptr

' -------------------------
' DRAW SOLID LINE
' -------------------------

    call    #draw_line

' -------------------------
' DISPLAY FRAME
' -------------------------

    call    #push_buffer

    call    #frame_delay

' -------------------------
' NEXT FRAME
' -------------------------

    add     frame_index, #1

    and     frame_index, #7

    jmp     #rotating_line_loop

' =========================
' RESET OLED
' =========================

reset_oled

    drvl    #oled_reset
    waitx   ##20_000

    drvh    #oled_reset
    waitx   ##9_000_000

    ret

' =========================
' OLED INIT
' =========================

oled_init

    mov     cmd, #$AE
    call    #send_cmd

    mov     cmd, #$D5
    call    #send_cmd

    mov     cmd, #$80
    call    #send_cmd

    mov     cmd, #$A8
    call    #send_cmd

    mov     cmd, #$3F
    call    #send_cmd

    mov     cmd, #$D3
    call    #send_cmd

    mov     cmd, #0
    call    #send_cmd

    mov     cmd, #$40
    call    #send_cmd

    mov     cmd, #$A0
    call    #send_cmd

    mov     cmd, #$C0
    call    #send_cmd

    mov     cmd, #$DA
    call    #send_cmd

    mov     cmd, #$12
    call    #send_cmd

    mov     cmd, #$81
    call    #send_cmd

    mov     cmd, #$7F
    call    #send_cmd

    mov     cmd, #$20
    call    #send_cmd

    mov     cmd, #$02
    call    #send_cmd

    mov     cmd, #$A4
    call    #send_cmd

    mov     cmd, #$A6
    call    #send_cmd

    mov     cmd, #$8D
    call    #send_cmd

    mov     cmd, #$14
    call    #send_cmd

    mov     cmd, #$AF
    call    #send_cmd

    ret

' =========================
' SEND COMMAND
' =========================

send_cmd

    drvl    #oled_cs
    drvl    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret

' =========================
' SEND DATA
' =========================

send_data

    drvl    #oled_cs
    drvh    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret

' =========================
' SET PAGE POSITION
' =========================

set_pos

    mov     cmd, page
    or      cmd, #$B0

    call    #send_cmd

    mov     cmd, #$00
    call    #send_cmd

    mov     cmd, #$10
    call    #send_cmd

    ret

' =========================
' CLEAR HUB FRAMEBUFFER
'
' 1024 bytes
'
' 256 longwords
' =========================

clear_buffer

    mov     ptr, ##frame_buffer
    mov     count, ##256
    mov     value, #0

clear_buffer_loop

    wrlong  value, ptr

    add     ptr, #4

    djnz    count, #clear_buffer_loop

    ret

' =========================
' PUSH HUB FRAMEBUFFER
'
' 8 pages
'
' 128 bytes per page
'
' 1024 total bytes
' =========================

push_buffer

    ' Read the HUB framebuffer from the end toward the beginning.
    ' Reversing byte order and bit order performs a 180-degree
    ' software rotation while keeping the OLED at $A0 / $C0.

    mov     ptr, ##frame_buffer
    add     ptr, ##1023

    mov     page, #0
    mov     page_count, #8

push_page_loop

    call    #set_pos
    mov     count, #128

push_column_loop

    rdbyte  cmd, ptr
    call    #rotate_display_byte
    call    #send_data

    sub     ptr, #1
    djnz    count, #push_column_loop

    add     page, #1
    djnz    page_count, #push_page_loop

    ret


' =========================
' REVERSE DATA BYTE FOR DISPLAY
'
' $A0/$C0 are kept as the controller's
' normal directions.  The module is mounted
' 180 degrees from the chosen viewing orientation,
' so framebuffer output is rotated in software.
' =========================

rotate_display_byte

    mov     rot_src, cmd
    mov     rot_dst, #0
    mov     rot_count, #8

rotate_display_byte_loop

    shl     rot_dst, #1
    testb   rot_src, #0 wc
if_c or      rot_dst, #1
    shr     rot_src, #1

    djnz    rot_count, #rotate_display_byte_loop

    mov     cmd, rot_dst
    ret

' =========================
' SET PIXEL IN HUB RAM
'
' xpos = 0 through 127
' ypos = 0 through 63
' =========================

set_pixel

    mov     offset, ypos

    shr     offset, #3
    shl     offset, #7

    add     offset, xpos

    mov     ptr, ##frame_buffer
    add     ptr, offset

    rdbyte  value, ptr

    mov     mask, #1

    mov     temp2, ypos
    and     temp2, #7

    shl     mask, temp2

    or      value, mask

    wrbyte  value, ptr

    ret

' =========================
' DRAW LINE
'
' Connect:
'
' x1,y1
'
' to:
'
' x2,y2
'
' X and Y move one pixel
' toward the endpoint.
'
' Because the rotating line
' uses only eight directions,
' this produces a clean,
' connected line.
' =========================

draw_line

    mov     line_x, x1
    mov     line_y, y1

draw_line_loop

' -------------------------
' DRAW CURRENT PIXEL
' -------------------------

    mov     xpos, line_x
    mov     ypos, line_y

    call    #set_pixel

' -------------------------
' FINISHED?
' -------------------------

    cmp     line_x, x2 wz

if_nz   jmp     #line_move_x

    cmp     line_y, y2 wz

if_z    ret

    jmp     #line_move_y

' =========================
' MOVE X TOWARD x2
' =========================

line_move_x

    cmp     line_x, x2 wz

if_z    jmp     #line_move_y

    cmp     line_x, x2 wc

if_c    jmp     #line_x_add

    sub     line_x, #1

    jmp     #line_move_y

line_x_add

    add     line_x, #1

' =========================
' MOVE Y TOWARD y2
' =========================

line_move_y

    cmp     line_y, y2 wz

if_z    jmp     #draw_line_loop

    cmp     line_y, y2 wc

if_c    jmp     #line_y_add

    sub     line_y, #1

    jmp     #draw_line_loop

line_y_add

    add     line_y, #1

    jmp     #draw_line_loop

' =========================
' FRAME DELAY
' =========================

frame_delay

    waitx   ##9_000_000

    ret

' =========================
' SOFTWARE SPI
' =========================

spi8

    mov     spi_count, #8

.loop

    testb   cmd, #7 wc

    outc    #oled_mosi

    waitx   ##100

    drvh    #oled_sck

    waitx   ##100

    drvl    #oled_sck

    waitx   ##100

    rol     cmd, #1

    djnz    spi_count, #.loop

    ret

' =========================
' END
' =========================

end

    jmp     #end

' =========================
' VARIABLES
' =========================

cmd             res 1
count           res 1
spi_count       res 1

page            res 1
page_count      res 1

xpos            res 1
ypos            res 1

temp            res 1
temp2           res 1

ptr             res 1
point_ptr       res 1

value           res 1
offset          res 1
mask            res 1

frame_index     res 1

x1              res 1
y1              res 1
x2              res 1
y2              res 1

line_x          res 1
line_y          res 1

' =========================
' HUB RAM
' =========================


rot_src         res 1
rot_dst         res 1
rot_count       res 1

    orgh

' =========================
' FRAMEBUFFER
'
' 128 x 64 monochrome OLED
'
' 8 pages x 128 bytes
'
' = 1024 bytes
' =========================

frame_buffer

    byte    0[1024]

' =========================
' ROTATING LINE ENDPOINTS
'
' Eight positions around the
' center of the screen.
'
' Frame 0 = right
' Frame 1 = lower-right
' Frame 2 = down
' Frame 3 = lower-left
' Frame 4 = left
' Frame 5 = upper-left
' Frame 6 = up
' Frame 7 = upper-right
'
' Then the sequence repeats.
' =========================

line_endpoints

    byte    94,32
    byte    85,49
    byte    64,58
    byte    43,49

    byte    34,32
    byte    43,15
    byte    64,6
    byte    85,15