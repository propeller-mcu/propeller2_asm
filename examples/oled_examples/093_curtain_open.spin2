' =========================================================
'
' P2ASM OLED DEMO 093 / 119
'
' Curtain Open
'
' Category: HUB RAM Animation
'
' =========================================================

CON
    _CLKFREQ = 180_000_000

    oled_sck   = 0
    oled_mosi  = 1
    oled_reset = 2
    oled_dc    = 3
    oled_cs    = 4

DAT
    org 0
    asmclk


' -------------------------
' GPIO INIT
' -------------------------

    drvh    #oled_cs
    drvh    #oled_dc
    drvl    #oled_sck
    dirh    #oled_mosi
    dirh    #oled_dc
    dirh    #oled_reset
    dirh    #oled_cs
    dirh    #oled_sck


' =========================
' MAIN
' =========================

main
    call    #reset_oled
    call    #oled_init


' =========================
' CURTAIN OPEN
'
' The display begins completely
' filled with pixels.
'
' A narrow empty opening appears
' in the center of the screen.
'
' Each new frame widens that
' opening equally toward the
' left and right edges.
'
' This gives the appearance of
' two curtains being pulled apart.
'
' When the opening reaches the
' full 128-pixel screen width,
' the animation pauses briefly
' and starts again.
' =========================

curtain_restart
    mov     opening_width, #4
    mov     frame_count, #32

curtain_open_loop


' -------------------------
' START WITH SOLID SCREEN
' -------------------------

    call    #fill_buffer


' -------------------------
' CALCULATE LEFT EDGE
'
' left edge =
'
' 64 - opening_width / 2
' -------------------------

    mov     temp, opening_width
    shr     temp, #1

    mov     curtain_x, #64
    sub     curtain_x, temp


' -------------------------
' CLEAR OPENING
'
' Clear opening_width complete
' vertical columns beginning at
' curtain_x.
' -------------------------

    mov     column_count, opening_width

curtain_column_loop

    mov     xpos, curtain_x
    mov     ypos, #0
    mov     line_count, #64

    call    #clear_vline

    add     curtain_x, #1

    djnz    column_count, #curtain_column_loop


' -------------------------
' DISPLAY FRAME
' -------------------------

    call    #push_buffer
    call    #short_delay


' -------------------------
' WIDEN CURTAIN OPENING
'
' Four more pixels are opened
' during every animation frame.
'
' Because the opening remains
' centered, this effectively
' moves each curtain two pixels
' toward its outside edge.
' -------------------------

    add     opening_width, #4
    djnz    frame_count, #curtain_open_loop


' -------------------------
' HOLD OPEN SCREEN
' -------------------------

    call    #frame_delay


' -------------------------
' START AGAIN
' -------------------------

    jmp     #curtain_restart


' =========================
' RESET OLED
' =========================

reset_oled
    drvl    #oled_reset
    waitx   ##20_000

    drvh    #oled_reset
    waitx   ##9_000_000

    ret


' =========================
' OLED INIT
' =========================

oled_init
    mov     cmd, #$AE
    call    #send_cmd

    mov     cmd, #$D5
    call    #send_cmd

    mov     cmd, #$80
    call    #send_cmd

    mov     cmd, #$A8
    call    #send_cmd

    mov     cmd, #$3F
    call    #send_cmd

    mov     cmd, #$D3
    call    #send_cmd

    mov     cmd, #0
    call    #send_cmd

    mov     cmd, #$40
    call    #send_cmd

    mov     cmd, #$A0
    call    #send_cmd

    mov     cmd, #$C0
    call    #send_cmd

    mov     cmd, #$DA
    call    #send_cmd

    mov     cmd, #$12
    call    #send_cmd

    mov     cmd, #$81
    call    #send_cmd

    mov     cmd, #$7F
    call    #send_cmd

    mov     cmd, #$20
    call    #send_cmd

    mov     cmd, #$02
    call    #send_cmd

    mov     cmd, #$A4
    call    #send_cmd

    mov     cmd, #$A6
    call    #send_cmd

    mov     cmd, #$8D
    call    #send_cmd

    mov     cmd, #$14
    call    #send_cmd

    mov     cmd, #$AF
    call    #send_cmd

    ret


' =========================
' SEND COMMAND
' =========================

send_cmd
    drvl    #oled_cs
    drvl    #oled_dc

    call    #spi8

    drvh    #oled_cs
    ret


' =========================
' SEND DATA
' =========================

send_data
    drvl    #oled_cs
    drvh    #oled_dc

    call    #spi8

    drvh    #oled_cs
    ret


' =========================
' SET PAGE POSITION
' =========================

set_pos
    mov     cmd, page
    or      cmd, #$B0
    call    #send_cmd

    mov     cmd, #$00
    call    #send_cmd

    mov     cmd, #$10
    call    #send_cmd

    ret


' =========================
' FILL HUB FRAMEBUFFER
'
' Sets every framebuffer bit.
'
' 1024 bytes =
' 256 longwords
'
' $FFFFFFFF fills the display.
' =========================

fill_buffer
    mov     ptr, ##frame_buffer
    mov     count, ##256
    mov     value, ##$FFFFFFFF

fill_buffer_loop
    wrlong  value, ptr
    add     ptr, #4
    djnz    count, #fill_buffer_loop

    ret


' =========================
' PUSH HUB FRAMEBUFFER
'
' Copies all 1024 framebuffer
' bytes from HUB RAM into
' OLED display RAM.
' =========================

push_buffer
    ' Read the HUB framebuffer from the end toward the beginning.
    ' Reversing byte order and bit order performs a 180-degree
    ' software rotation while keeping the OLED at $A0 / $C0.

    mov     ptr, ##frame_buffer
    add     ptr, ##1023

    mov     page, #0
    mov     page_count, #8

push_page_loop
    call    #set_pos

    mov     count, #128

push_column_loop
    rdbyte  cmd, ptr

    call    #rotate_display_byte
    call    #send_data

    sub     ptr, #1
    djnz    count, #push_column_loop

    add     page, #1
    djnz    page_count, #push_page_loop

    ret


' =========================
' REVERSE DATA BYTE FOR DISPLAY
'
' $A0/$C0 are kept as the controller's
' normal directions. The module is mounted
' 180 degrees from the chosen viewing orientation,
' so framebuffer output is rotated in software.
' =========================

rotate_display_byte
    mov     rot_src, cmd
    mov     rot_dst, #0
    mov     rot_count, #8

rotate_display_byte_loop
    shl     rot_dst, #1

    testb   rot_src, #0 wc
if_c  or    rot_dst, #1

    shr     rot_src, #1

    djnz    rot_count, #rotate_display_byte_loop

    mov     cmd, rot_dst

    ret


' =========================
' CLEAR PIXEL IN HUB RAM
'
' xpos = 0 through 127
' ypos = 0 through 63
'
' Finds the framebuffer byte
' containing the selected pixel
' and clears only that bit.
' =========================

clear_pixel
    mov     offset, ypos
    shr     offset, #3
    shl     offset, #7
    add     offset, xpos

    mov     ptr, ##frame_buffer
    add     ptr, offset

    rdbyte  value, ptr

    mov     mask, #1

    mov     temp2, ypos
    and     temp2, #7
    shl     mask, temp2

    xor     mask, #$FF
    and     value, mask

    wrbyte  value, ptr

    ret


' =========================
' CLEAR VERTICAL LINE
'
' xpos       = X position
' ypos       = starting Y
' line_count = number of pixels
'
' Used to remove one complete
' vertical column from the
' filled framebuffer.
' =========================

clear_vline

clear_vline_loop
    call    #clear_pixel

    add     ypos, #1

    djnz    line_count, #clear_vline_loop

    ret


' =========================
' SHORT DELAY
'
' Delay between curtain frames.
' =========================

short_delay
    waitx   ##6_000_000

    ret


' =========================
' FRAME DELAY
'
' Holds the fully opened
' curtain briefly before
' restarting the animation.
' =========================

frame_delay
    waitx   ##36_000_000

    ret


' =========================
' SOFTWARE SPI
' =========================

spi8
    mov     spi_count, #8

.loop
    testb   cmd, #7 wc

    outc    #oled_mosi

    waitx   ##100

    drvh    #oled_sck

    waitx   ##100

    drvl    #oled_sck

    waitx   ##100

    rol     cmd, #1

    djnz    spi_count, #.loop

    ret


' =========================
' END
' =========================

end
    jmp     #end


' =========================
' VARIABLES
' =========================

cmd             res 1
count           res 1
spi_count       res 1

page            res 1
page_count      res 1

xpos            res 1
ypos            res 1

temp            res 1
temp2           res 1

ptr             res 1

value           res 1
offset          res 1
mask            res 1

line_count      res 1
column_count    res 1

opening_width   res 1
curtain_x       res 1

frame_count     res 1


' =========================
' HUB RAM
' =========================

rot_src         res 1
rot_dst         res 1
rot_count       res 1

    orgh


' =========================
' FRAMEBUFFER
'
' 128 x 64 monochrome OLED
'
' 8 pages x 128 bytes
'
' = 1024 bytes
' =========================

frame_buffer
    byte    0[1024]