' =========================================================
'
' P2ASM OLED DEMO 010 / 119
'
' Triangle Outline
'
' Category: OLED Graphics
'
' =========================================================

CON

    _CLKFREQ = 180_000_000

    oled_sck   = 0
    oled_mosi  = 1
    oled_reset = 2
    oled_dc    = 3
    oled_cs    = 4

DAT

    org 0
    asmclk

' -------------------------
' GPIO INIT
' -------------------------

    drvh    #oled_cs
    drvh    #oled_dc
    drvl    #oled_sck
    dirh    #oled_mosi
    dirh    #oled_dc
    dirh    #oled_reset
    dirh    #oled_cs
    dirh    #oled_sck


' =========================
' MAIN
' =========================

main

    call    #reset_oled
    call    #oled_init
    call    #clear_screen

    ' Draw triangle outline
    '
    ' Base:
    '
    ' X = 33 through 95
    ' Y = 16
    '
    ' Apex:
    '
    ' X = 64
    ' Y = 47

    call    #draw_triangle

    jmp     #end


' =========================
' RESET OLED
' =========================

reset_oled

    drvl    #oled_reset
    waitx   ##20_000

    drvh    #oled_reset

    ' Give OLED time
    ' to stabilize

    waitx   ##9_000_000

    ret


' =========================
' OLED INIT
' =========================

oled_init

    mov     cmd, #$AE
    call    #send_cmd

    mov     cmd, #$D5
    call    #send_cmd

    mov     cmd, #$80
    call    #send_cmd

    mov     cmd, #$A8
    call    #send_cmd

    mov     cmd, #$3F
    call    #send_cmd

    mov     cmd, #$D3
    call    #send_cmd

    mov     cmd, #0
    call    #send_cmd

    mov     cmd, #$40
    call    #send_cmd

    ' Normal segment direction

    mov     cmd, #$A0
    call    #send_cmd

    ' Normal COM scan direction

    mov     cmd, #$C0
    call    #send_cmd

    mov     cmd, #$DA
    call    #send_cmd

    mov     cmd, #$12
    call    #send_cmd

    mov     cmd, #$81
    call    #send_cmd

    mov     cmd, #$7F
    call    #send_cmd

    mov     cmd, #$20
    call    #send_cmd

    ' Page addressing mode

    mov     cmd, #$02
    call    #send_cmd

    mov     cmd, #$A4
    call    #send_cmd

    mov     cmd, #$A6
    call    #send_cmd

    mov     cmd, #$8D
    call    #send_cmd

    mov     cmd, #$14
    call    #send_cmd

    mov     cmd, #$AF
    call    #send_cmd

    ret


' =========================
' SEND COMMAND
' =========================

send_cmd

    drvl    #oled_cs
    drvl    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret


' =========================
' SEND DATA
' =========================

send_data

    drvl    #oled_cs
    drvh    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret


' =========================
' SET PAGE POSITION
' =========================

set_pos

    ' Select page 0-7

    mov     cmd, page
    or      cmd, #$B0
    call    #send_cmd

    ' Column low nibble = 0

    mov     cmd, #$00
    call    #send_cmd

    ' Column high nibble = 0

    mov     cmd, #$10
    call    #send_cmd

    ret


' =========================
' SET X POSITION
'
' xpos = 0 - 127
' =========================

set_xpos

    ' Low column nibble

    mov     temp, xpos
    and     temp, #$0F

    mov     cmd, temp
    call    #send_cmd

    ' High column nibble

    mov     temp, xpos
    shr     temp, #4
    and     temp, #$0F
    or      temp, #$10

    mov     cmd, temp
    call    #send_cmd

    ret


' =========================
' CLEAR SCREEN
'
' 8 pages
' 128 bytes per page
'
' $00 = 00000000
' =========================

clear_screen

    mov     page, #0

clear_page_loop

    call    #set_pos

    mov     count, #128

clear_column_loop

    mov     cmd, #$00
    call    #send_data

    djnz    count, #clear_column_loop

    add     page, #1

    cmp     page, #8 wz

    if_nz   jmp     #clear_page_loop

    ret


' =========================
' DRAW TRIANGLE
'
' Base:
'
' X = 33 through 95
' Y = 16
'
' Apex:
'
' X = 64
' Y = 47
'
' Page 2 contains Y = 16-23.
'
' Bit 0 represents Y = 16.
'
' The first 8 diagonal pixels
' share page 2 with the base.
' =========================

draw_triangle

    ' -------------------------
    ' LEFT LOWER CORNER
    '
    ' X = 33 through 40
    '
    ' Pixels:
    '
    ' 33,16
    ' 34,17
    ' 35,18
    ' ...
    ' 40,23
    ' -------------------------

    mov     page, #2

    mov     cmd, page
    or      cmd, #$B0
    call    #send_cmd

    mov     xpos, #33
    call    #set_xpos

    mov     mask, #1
    mov     count, #8

left_corner_loop

    ' Add diagonal pixel
    ' while keeping
    ' the base pixel on.

    mov     cmd, mask
    or      cmd, #1
    call    #send_data

    shl     mask, #1

    djnz    count, #left_corner_loop


    ' -------------------------
    ' CENTER OF BASE
    '
    ' X = 41 through 87
    ' Y = 16
    '
    ' $01 = bit 0
    ' -------------------------

    mov     xpos, #41
    call    #set_xpos

    mov     count, #47

base_loop

    mov     cmd, #$01
    call    #send_data

    djnz    count, #base_loop


    ' -------------------------
    ' RIGHT LOWER CORNER
    '
    ' X = 88 through 95
    '
    ' Pixels:
    '
    ' 88,23
    ' 89,22
    ' 90,21
    ' ...
    ' 95,16
    ' -------------------------

    mov     xpos, #88
    call    #set_xpos

    mov     mask, #$80
    mov     count, #8

right_corner_loop

    mov     cmd, mask
    or      cmd, #1
    call    #send_data

    shr     mask, #1

    djnz    count, #right_corner_loop


    ' -------------------------
    ' LEFT DIAGONAL
    '
    ' Continues directly from:
    '
    ' 40,23
    '
    ' Start:
    '
    ' 41,24
    '
    ' End:
    '
    ' 64,47
    ' -------------------------

    mov     xpos, #41
    mov     ypos, #24
    mov     line_count, #24

left_diag_loop

    call    #draw_pixel

    add     xpos, #1
    add     ypos, #1

    djnz    line_count, #left_diag_loop


    ' -------------------------
    ' RIGHT DIAGONAL
    '
    ' Continues directly from:
    '
    ' 88,23
    '
    ' Start:
    '
    ' 87,24
    '
    ' End:
    '
    ' 64,47
    ' -------------------------

    mov     xpos, #87
    mov     ypos, #24
    mov     line_count, #24

right_diag_loop

    call    #draw_pixel

    sub     xpos, #1
    add     ypos, #1

    djnz    line_count, #right_diag_loop

    ret


' =========================
' DRAW PIXEL
'
' xpos = 0 - 127
' ypos = 0 - 63
' =========================

draw_pixel

    ' Find OLED page
    '
    ' page = ypos / 8

    mov     page, ypos
    shr     page, #3

    ' Select page

    mov     cmd, page
    or      cmd, #$B0
    call    #send_cmd

    ' Set X position

    call    #set_xpos

    ' Create pixel bit mask

    mov     mask, #1

    mov     temp, ypos
    and     temp, #7

bit_loop

    tjz     temp, #bit_done

    shl     mask, #1
    sub     temp, #1

    jmp     #bit_loop

bit_done

    mov     cmd, mask
    call    #send_data

    ret


' =========================
' SOFTWARE SPI
'
' Slow / beginner-friendly
' bit-banged SPI timing
' =========================

spi8

    mov     x, #8

.loop

    ' Get bit 7 of cmd

    testb   cmd, #7 wc

    ' Put bit on MOSI

    outc    #oled_mosi

    ' Allow MOSI to settle

    waitx   ##100

    ' Clock HIGH

    drvh    #oled_sck
    waitx   ##100

    ' Clock LOW

    drvl    #oled_sck
    waitx   ##100

    ' Move next bit
    ' into bit 7

    rol     cmd, #1

    ' Repeat for 8 bits

    djnz    x, #.loop

    ret


' =========================
' END
' =========================

end

    jmp     #end


' =========================
' VARIABLES
' =========================

cmd         res 1
count       res 1
x           res 1
page        res 1
xpos        res 1
ypos        res 1
mask        res 1
temp        res 1
line_count  res 1