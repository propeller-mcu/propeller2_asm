' =========================================================
'
' P2ASM OLED DEMO 106 / 119
'
' Animated Face
'
' Category: HUB RAM Animation
'
' =========================================================

CON

    _CLKFREQ = 180_000_000

    oled_sck   = 0
    oled_mosi  = 1
    oled_reset = 2
    oled_dc    = 3
    oled_cs    = 4

DAT

    org 0
    asmclk

' -------------------------
' GPIO INIT
' -------------------------

    drvh    #oled_cs
    drvh    #oled_dc
    drvl    #oled_sck
    dirh    #oled_mosi
    dirh    #oled_dc
    dirh    #oled_reset
    dirh    #oled_cs
    dirh    #oled_sck

' =========================
' MAIN
' =========================

main

    call    #reset_oled
    call    #oled_init

' =========================
' ANIMATED FACE
'
' Four frames:
'
' 0 = smile
' 1 = blink
' 2 = smile
' 3 = surprised
'
' The sequence repeats forever.
' =========================

face_loop

' =========================
' FRAME 0
'
' SMILING FACE
' =========================

    call    #clear_buffer

    call    #draw_head

    call    #draw_open_eyes

    call    #draw_smile

    call    #push_buffer
    call    #frame_delay

' =========================
' FRAME 1
'
' BLINK
' =========================

    call    #clear_buffer

    call    #draw_head

    call    #draw_closed_eyes

    call    #draw_smile

    call    #push_buffer
    call    #blink_delay

' =========================
' FRAME 2
'
' SMILING FACE AGAIN
' =========================

    call    #clear_buffer

    call    #draw_head

    call    #draw_open_eyes

    call    #draw_smile

    call    #push_buffer
    call    #frame_delay

' =========================
' FRAME 3
'
' SURPRISED FACE
' =========================

    call    #clear_buffer

    call    #draw_head

    call    #draw_open_eyes

    call    #draw_surprised_mouth

    call    #push_buffer
    call    #frame_delay

    jmp     #face_loop

' =========================
' DRAW HEAD
'
' Center:
'
' X = 64
' Y = 32
'
' Radius = 23
' =========================

draw_head

    mov     center_x, #64
    mov     center_y, #32

    mov     radius, #23

    call    #draw_circle

    ret

' =========================
' OPEN EYES
'
' Each eye is a small
' 3 x 3 filled block.
' =========================

draw_open_eyes

' -------------------------
' LEFT EYE
' -------------------------

    mov     ypos, #24
    mov     row_count, #3

left_eye_row

    mov     xpos, #54
    mov     column_count, #3

left_eye_pixel

    call    #set_pixel

    add     xpos, #1

    djnz    column_count, #left_eye_pixel

    add     ypos, #1

    djnz    row_count, #left_eye_row

' -------------------------
' RIGHT EYE
' -------------------------

    mov     ypos, #24
    mov     row_count, #3

right_eye_row

    mov     xpos, #71
    mov     column_count, #3

right_eye_pixel

    call    #set_pixel

    add     xpos, #1

    djnz    column_count, #right_eye_pixel

    add     ypos, #1

    djnz    row_count, #right_eye_row

    ret

' =========================
' CLOSED EYES
'
' Short horizontal lines
' create a blink.
' =========================

draw_closed_eyes

' -------------------------
' LEFT
' -------------------------

    mov     xpos, #53
    mov     ypos, #26
    mov     line_count, #5

    call    #draw_hline

' -------------------------
' RIGHT
' -------------------------

    mov     xpos, #70
    mov     ypos, #26
    mov     line_count, #5

    call    #draw_hline

    ret

' =========================
' SMILE
'
' A shallow curved mouth:
'
' 56,38
' 57,39
' 58..70,40
' 71,39
' 72,38
' =========================

draw_smile

' -------------------------
' LEFT CORNER
' -------------------------

    mov     xpos, #56
    mov     ypos, #38

    call    #set_pixel

    mov     xpos, #57
    mov     ypos, #39

    call    #set_pixel

' -------------------------
' BOTTOM OF SMILE
' -------------------------

    mov     xpos, #58
    mov     ypos, #40
    mov     line_count, #13

    call    #draw_hline

' -------------------------
' RIGHT CORNER
' -------------------------

    mov     xpos, #71
    mov     ypos, #39

    call    #set_pixel

    mov     xpos, #72
    mov     ypos, #38

    call    #set_pixel

    ret

' =========================
' SURPRISED MOUTH
'
' Small round-looking mouth.
'
' 5 x 7 outline.
' =========================

draw_surprised_mouth

' -------------------------
' TOP
' -------------------------

    mov     xpos, #62
    mov     ypos, #37
    mov     line_count, #5

    call    #draw_hline

' -------------------------
' BOTTOM
' -------------------------

    mov     xpos, #62
    mov     ypos, #43
    mov     line_count, #5

    call    #draw_hline

' -------------------------
' LEFT
' -------------------------

    mov     xpos, #61
    mov     ypos, #38
    mov     line_count, #5

    call    #draw_vline

' -------------------------
' RIGHT
' -------------------------

    mov     xpos, #67
    mov     ypos, #38
    mov     line_count, #5

    call    #draw_vline

    ret

' =========================
' RESET OLED
' =========================

reset_oled

    drvl    #oled_reset
    waitx   ##20_000

    drvh    #oled_reset
    waitx   ##9_000_000

    ret

' =========================
' OLED INIT
' =========================

oled_init

    mov     cmd, #$AE
    call    #send_cmd

    mov     cmd, #$D5
    call    #send_cmd

    mov     cmd, #$80
    call    #send_cmd

    mov     cmd, #$A8
    call    #send_cmd

    mov     cmd, #$3F
    call    #send_cmd

    mov     cmd, #$D3
    call    #send_cmd

    mov     cmd, #0
    call    #send_cmd

    mov     cmd, #$40
    call    #send_cmd

    mov     cmd, #$A0
    call    #send_cmd

    mov     cmd, #$C0
    call    #send_cmd

    mov     cmd, #$DA
    call    #send_cmd

    mov     cmd, #$12
    call    #send_cmd

    mov     cmd, #$81
    call    #send_cmd

    mov     cmd, #$7F
    call    #send_cmd

    mov     cmd, #$20
    call    #send_cmd

    mov     cmd, #$02
    call    #send_cmd

    mov     cmd, #$A4
    call    #send_cmd

    mov     cmd, #$A6
    call    #send_cmd

    mov     cmd, #$8D
    call    #send_cmd

    mov     cmd, #$14
    call    #send_cmd

    mov     cmd, #$AF
    call    #send_cmd

    ret

' =========================
' SEND COMMAND
' =========================

send_cmd

    drvl    #oled_cs
    drvl    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret

' =========================
' SEND DATA
' =========================

send_data

    drvl    #oled_cs
    drvh    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret

' =========================
' SET PAGE POSITION
' =========================

set_pos

    mov     cmd, page
    or      cmd, #$B0

    call    #send_cmd

    mov     cmd, #$00
    call    #send_cmd

    mov     cmd, #$10
    call    #send_cmd

    ret

' =========================
' CLEAR HUB FRAMEBUFFER
' =========================

clear_buffer

    mov     ptr, ##frame_buffer
    mov     count, ##256
    mov     value, #0

clear_buffer_loop

    wrlong  value, ptr

    add     ptr, #4

    djnz    count, #clear_buffer_loop

    ret

' =========================
' PUSH HUB FRAMEBUFFER
' =========================

push_buffer

    ' Read the HUB framebuffer from the end toward the beginning.
    ' Reversing byte order and bit order performs a 180-degree
    ' software rotation while keeping the OLED at $A0 / $C0.

    mov     ptr, ##frame_buffer
    add     ptr, ##1023

    mov     page, #0
    mov     page_count, #8

push_page_loop

    call    #set_pos
    mov     count, #128

push_column_loop

    rdbyte  cmd, ptr
    call    #rotate_display_byte
    call    #send_data

    sub     ptr, #1
    djnz    count, #push_column_loop

    add     page, #1
    djnz    page_count, #push_page_loop

    ret


' =========================
' REVERSE DATA BYTE FOR DISPLAY
'
' $A0/$C0 are kept as the controller's
' normal directions.  The module is mounted
' 180 degrees from the chosen viewing orientation,
' so framebuffer output is rotated in software.
' =========================

rotate_display_byte

    mov     rot_src, cmd
    mov     rot_dst, #0
    mov     rot_count, #8

rotate_display_byte_loop

    shl     rot_dst, #1
    testb   rot_src, #0 wc
if_c or      rot_dst, #1
    shr     rot_src, #1

    djnz    rot_count, #rotate_display_byte_loop

    mov     cmd, rot_dst
    ret

' =========================
' SET PIXEL IN HUB RAM
' =========================

set_pixel

    mov     offset, ypos

    shr     offset, #3
    shl     offset, #7

    add     offset, xpos

    mov     ptr, ##frame_buffer
    add     ptr, offset

    rdbyte  value, ptr

    mov     mask, #1

    mov     temp, ypos
    and     temp, #7

    shl     mask, temp

    or      value, mask

    wrbyte  value, ptr

    ret

' =========================
' DRAW HORIZONTAL LINE
' =========================

draw_hline

draw_hline_loop

    call    #set_pixel

    add     xpos, #1

    djnz    line_count, #draw_hline_loop

    ret

' =========================
' DRAW VERTICAL LINE
' =========================

draw_vline

draw_vline_loop

    call    #set_pixel

    add     ypos, #1

    djnz    line_count, #draw_vline_loop

    ret

' =========================
' DRAW CIRCLE
'
' Connected integer circle.
'
' For each Y position, X is
' moved inward until:
'
' X^2 + Y^2 <= R^2
'
' The resulting point is then
' mirrored into all eight
' octants.
' =========================

draw_circle

    mov     radius_squared, radius

    mul     radius_squared, radius

    mov     circle_y, #0

circle_y_loop

    mov     circle_x, radius

circle_find_x

    mov     x_squared, circle_x
    mul     x_squared, circle_x

    mov     y_squared, circle_y
    mul     y_squared, circle_y

    mov     distance_squared, x_squared
    add     distance_squared, y_squared

    cmp     distance_squared, radius_squared wc

if_be   jmp     #circle_x_found

    sub     circle_x, #1

    jmp     #circle_find_x

circle_x_found

    call    #plot_circle_points

    add     circle_y, #1

    cmp     circle_y, radius wc

if_be   jmp     #circle_y_loop

    ret

' =========================
' PLOT 8 CIRCLE POINTS
' =========================

plot_circle_points

' -------------------------
' +X, +Y
' -------------------------

    mov     xpos, center_x
    add     xpos, circle_x

    mov     ypos, center_y
    add     ypos, circle_y

    call    #set_pixel

' -------------------------
' +Y, +X
' -------------------------

    mov     xpos, center_x
    add     xpos, circle_y

    mov     ypos, center_y
    add     ypos, circle_x

    call    #set_pixel

' -------------------------
' -Y, +X
' -------------------------

    mov     xpos, center_x
    sub     xpos, circle_y

    mov     ypos, center_y
    add     ypos, circle_x

    call    #set_pixel

' -------------------------
' -X, +Y
' -------------------------

    mov     xpos, center_x
    sub     xpos, circle_x

    mov     ypos, center_y
    add     ypos, circle_y

    call    #set_pixel

' -------------------------
' -X, -Y
' -------------------------

    mov     xpos, center_x
    sub     xpos, circle_x

    mov     ypos, center_y
    sub     ypos, circle_y

    call    #set_pixel

' -------------------------
' -Y, -X
' -------------------------

    mov     xpos, center_x
    sub     xpos, circle_y

    mov     ypos, center_y
    sub     ypos, circle_x

    call    #set_pixel

' -------------------------
' +Y, -X
' -------------------------

    mov     xpos, center_x
    add     xpos, circle_y

    mov     ypos, center_y
    sub     ypos, circle_x

    call    #set_pixel

' -------------------------
' +X, -Y
' -------------------------

    mov     xpos, center_x
    add     xpos, circle_x

    mov     ypos, center_y
    sub     ypos, circle_y

    call    #set_pixel

    ret

' =========================
' FRAME DELAY
'
' Normal expression frame.
' =========================

frame_delay

    waitx   ##30_000_000

    ret

' =========================
' BLINK DELAY
'
' Blink is deliberately much
' shorter than the other faces.
' =========================

blink_delay

    waitx   ##9_000_000

    ret

' =========================
' SOFTWARE SPI
' =========================

spi8

    mov     spi_count, #8

.loop

    testb   cmd, #7 wc

    outc    #oled_mosi

    waitx   ##100

    drvh    #oled_sck

    waitx   ##100

    drvl    #oled_sck

    waitx   ##100

    rol     cmd, #1

    djnz    spi_count, #.loop

    ret

' =========================
' END
' =========================

end

    jmp     #end

' =========================
' VARIABLES
' =========================

cmd                 res 1
count               res 1
spi_count           res 1

page                res 1
page_count          res 1

xpos                res 1
ypos                res 1

temp                res 1
ptr                 res 1

value               res 1
offset              res 1
mask                res 1

line_count          res 1
row_count           res 1
column_count        res 1

center_x            res 1
center_y            res 1

radius              res 1
radius_squared      res 1

circle_x            res 1
circle_y            res 1

x_squared           res 1
y_squared           res 1
distance_squared    res 1

' =========================
' HUB RAM
' =========================


rot_src         res 1
rot_dst         res 1
rot_count       res 1

    orgh

' =========================
' FRAMEBUFFER
'
' 128 x 64 monochrome OLED
'
' 8 pages x 128 bytes
'
' = 1024 bytes
' =========================

frame_buffer

    byte    0[1024]