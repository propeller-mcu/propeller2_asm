' =========================================================
'
' P2ASM OLED DEMO 001 / 119
'
' Full Screen Fill
'
' Category: OLED Graphics
'
' =========================================================

CON

    _CLKFREQ = 180_000_000

    oled_sck   = 0
    oled_mosi  = 1
    oled_reset = 2
    oled_dc    = 3
    oled_cs    = 4

DAT

    org 0
    asmclk

' -------------------------
' GPIO INIT
' -------------------------

    drvh    #oled_cs
    drvh    #oled_dc
    drvl    #oled_sck
    dirh    #oled_mosi
    dirh    #oled_dc
    dirh    #oled_reset
    dirh    #oled_cs
    dirh    #oled_sck


' =========================
' MAIN
' =========================

main

    call    #reset_oled

    call    #oled_init

    call    #fill_screen

    jmp     #end


' =========================
' RESET OLED
' =========================

reset_oled

    drvl    #oled_reset

    waitx   ##20_000

    drvh    #oled_reset

    ' Give OLED time to stabilize

    waitx   ##9_000_000

    ret


' =========================
' OLED INIT
' =========================

oled_init

    mov     cmd, #$AE        ' Display off
    call    #send_cmd


    mov     cmd, #$D5        ' Display clock
    call    #send_cmd

    mov     cmd, #$80
    call    #send_cmd


    mov     cmd, #$A8        ' Multiplex ratio
    call    #send_cmd

    mov     cmd, #$3F        ' 64 rows
    call    #send_cmd


    mov     cmd, #$D3        ' Display offset
    call    #send_cmd

    mov     cmd, #0
    call    #send_cmd


    mov     cmd, #$40        ' Start line
    call    #send_cmd


    mov     cmd, #$A0        ' Normal segment direction
    call    #send_cmd


    mov     cmd, #$C0        ' Normal COM scan direction
    call    #send_cmd


    mov     cmd, #$DA        ' COM pin config
    call    #send_cmd

    mov     cmd, #$12
    call    #send_cmd


    mov     cmd, #$81        ' Contrast
    call    #send_cmd

    mov     cmd, #$7F
    call    #send_cmd


    mov     cmd, #$20        ' Addressing mode
    call    #send_cmd

    mov     cmd, #$00        ' Horizontal addressing mode
    call    #send_cmd


    mov     cmd, #$A4        ' Use display RAM
    call    #send_cmd


    mov     cmd, #$A6        ' Normal display
    call    #send_cmd


    mov     cmd, #$8D        ' Charge pump
    call    #send_cmd

    mov     cmd, #$14
    call    #send_cmd


    mov     cmd, #$AF        ' Display on
    call    #send_cmd

    ret


' =========================
' SEND COMMAND
' =========================

send_cmd

    drvl    #oled_cs

    drvl    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret


' =========================
' SEND DATA
' =========================

send_data

    drvl    #oled_cs

    drvh    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret


' =========================
' FILL SCREEN
'
' 128 columns
' 8 pages
'
' 128 x 8 = 1024 bytes
'
' $FF = 11111111
'
' =========================

fill_screen

    ' Set column range
    ' 0 - 127

    mov     cmd, #$21
    call    #send_cmd

    mov     cmd, #0
    call    #send_cmd

    mov     cmd, #127
    call    #send_cmd


    ' Set page range
    ' 0 - 7

    mov     cmd, #$22
    call    #send_cmd

    mov     cmd, #0
    call    #send_cmd

    mov     cmd, #7
    call    #send_cmd


    ' Send 1024 bytes
    ' $FF turns every pixel on

    mov     count, ##1024


fill_loop

    mov     cmd, #$FF

    call    #send_data

    djnz    count, #fill_loop

    ret


' =========================
' SOFTWARE SPI
' =========================

spi8

    mov     x, #8


.loop

    testb   cmd, #7 wc

    outc    #oled_mosi


    drvh    #oled_sck

    waitx   ##2


    drvl    #oled_sck

    waitx   ##2


    rol     cmd, #1

    djnz    x, #.loop

    ret


' =========================
' END
' =========================

end

    jmp     #end


' =========================
' VARIABLES
' =========================

cmd     res 1
count   res 1
x       res 1