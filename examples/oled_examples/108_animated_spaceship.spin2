' =========================================================
'
' P2ASM OLED DEMO 108 / 119
'
' Animated Spaceship
'
' Category: HUB RAM Animation
'
' =========================================================

CON

    _CLKFREQ = 180_000_000

    oled_sck   = 0
    oled_mosi  = 1
    oled_reset = 2
    oled_dc    = 3
    oled_cs    = 4

DAT

    org 0
    asmclk

' -------------------------
' GPIO INIT
' -------------------------

    drvh    #oled_cs
    drvh    #oled_dc
    drvl    #oled_sck
    dirh    #oled_mosi
    dirh    #oled_dc
    dirh    #oled_reset
    dirh    #oled_cs
    dirh    #oled_sck

' =========================
' MAIN
' =========================

main

    call    #reset_oled
    call    #oled_init

' -------------------------
' START SHIP OFF LEFT SIDE
' -------------------------

    mov     ship_x, #0

' -------------------------
' FLAME FRAME
'
' 0 = short flame
' 1 = long flame
' -------------------------

    mov     flame_frame, #0

' =========================
' ANIMATED SPACESHIP
'
' The ship moves horizontally
' across the OLED.
'
' Each frame:
'
' 1. Clear HUB framebuffer
' 2. Draw spaceship body
' 3. Draw flickering engine flame
' 4. Push framebuffer
' 5. Advance ship position
'
' When the ship reaches the
' right side, it wraps back to
' the left.
' =========================

spaceship_loop

    call    #clear_buffer

    call    #draw_spaceship

' -------------------------
' SELECT ENGINE FLAME
' -------------------------

    cmp     flame_frame, #0 wz

if_z    call    #draw_short_flame
if_nz   call    #draw_long_flame

' -------------------------
' DISPLAY FRAME
' -------------------------

    call    #push_buffer

    call    #frame_delay

' -------------------------
' MOVE SHIP RIGHT
' -------------------------

    add     ship_x, #2

' -------------------------
' WRAP POSITION
'
' Ship width is about 18 pixels.
'
' Starting again before 128
' keeps coordinates safely
' inside the framebuffer.
' -------------------------

    cmp     ship_x, #108 wc

if_ae   mov     ship_x, #0

' -------------------------
' TOGGLE FLAME
' -------------------------

    xor     flame_frame, #1

    jmp     #spaceship_loop

' =========================
' DRAW SPACESHIP
'
' ship_x controls horizontal
' position.
'
' Center Y is around 32.
'
' The ship points toward
' the right side of the screen.
' =========================

draw_spaceship

' =========================
' NOSE
' =========================

    mov     xpos, ship_x
    add     xpos, #17

    mov     ypos, #32

    call    #set_pixel

' -------------------------
' FRONT UPPER EDGE
' -------------------------

    mov     xpos, ship_x
    add     xpos, #16

    mov     ypos, #31

    call    #set_pixel

    mov     xpos, ship_x
    add     xpos, #15

    mov     ypos, #30

    call    #set_pixel

    mov     xpos, ship_x
    add     xpos, #14

    mov     ypos, #29

    call    #set_pixel

' -------------------------
' FRONT LOWER EDGE
' -------------------------

    mov     xpos, ship_x
    add     xpos, #16

    mov     ypos, #33

    call    #set_pixel

    mov     xpos, ship_x
    add     xpos, #15

    mov     ypos, #34

    call    #set_pixel

    mov     xpos, ship_x
    add     xpos, #14

    mov     ypos, #35

    call    #set_pixel

' =========================
' MAIN BODY
'
' Filled center section.
' =========================

    mov     ypos, #29
    mov     row_count, #7

ship_body_row

    mov     xpos, ship_x
    add     xpos, #6

    mov     column_count, #9

ship_body_pixel

    call    #set_pixel

    add     xpos, #1

    djnz    column_count, #ship_body_pixel

    add     ypos, #1

    djnz    row_count, #ship_body_row

' =========================
' TOP FIN
' =========================

    mov     xpos, ship_x
    add     xpos, #8

    mov     ypos, #28
    mov     line_count, #5

    call    #draw_hline

    mov     xpos, ship_x
    add     xpos, #9

    mov     ypos, #27
    mov     line_count, #3

    call    #draw_hline

    mov     xpos, ship_x
    add     xpos, #10

    mov     ypos, #26

    call    #set_pixel

' =========================
' BOTTOM FIN
' =========================

    mov     xpos, ship_x
    add     xpos, #8

    mov     ypos, #36
    mov     line_count, #5

    call    #draw_hline

    mov     xpos, ship_x
    add     xpos, #9

    mov     ypos, #37
    mov     line_count, #3

    call    #draw_hline

    mov     xpos, ship_x
    add     xpos, #10

    mov     ypos, #38

    call    #set_pixel

' =========================
' REAR BODY
' =========================

    mov     xpos, ship_x
    add     xpos, #4

    mov     ypos, #30
    mov     line_count, #5

    call    #draw_vline

    mov     xpos, ship_x
    add     xpos, #5

    mov     ypos, #29
    mov     line_count, #7

    call    #draw_vline

' =========================
' COCKPIT
'
' Small hollow-looking area
' near front of ship.
' =========================

    mov     xpos, ship_x
    add     xpos, #11

    mov     ypos, #31

    call    #clear_pixel

    mov     xpos, ship_x
    add     xpos, #12

    mov     ypos, #31

    call    #clear_pixel

    mov     xpos, ship_x
    add     xpos, #11

    mov     ypos, #32

    call    #clear_pixel

    mov     xpos, ship_x
    add     xpos, #12

    mov     ypos, #32

    call    #clear_pixel

    ret

' =========================
' SHORT ENGINE FLAME
'
' Small three-pixel exhaust.
' =========================

draw_short_flame

    mov     xpos, ship_x
    add     xpos, #3

    mov     ypos, #31

    call    #set_pixel

    mov     xpos, ship_x
    add     xpos, #2

    mov     ypos, #32

    call    #set_pixel

    mov     xpos, ship_x
    add     xpos, #3

    mov     ypos, #33

    call    #set_pixel

    ret

' =========================
' LONG ENGINE FLAME
'
' Longer exhaust frame.
'
' Alternating between short
' and long creates flicker.
' =========================

draw_long_flame

' -------------------------
' INNER FLAME
' -------------------------

    mov     xpos, ship_x
    add     xpos, #3

    mov     ypos, #30

    call    #set_pixel

    mov     xpos, ship_x
    add     xpos, #3

    mov     ypos, #31

    call    #set_pixel

    mov     xpos, ship_x
    add     xpos, #2

    mov     ypos, #32

    call    #set_pixel

    mov     xpos, ship_x
    add     xpos, #3

    mov     ypos, #33

    call    #set_pixel

    mov     xpos, ship_x
    add     xpos, #3

    mov     ypos, #34

    call    #set_pixel

' -------------------------
' LONG TAIL
' -------------------------

    mov     xpos, ship_x
    add     xpos, #1

    mov     ypos, #31

    call    #set_pixel

    mov     xpos, ship_x

    mov     ypos, #32

    call    #set_pixel

    mov     xpos, ship_x
    add     xpos, #1

    mov     ypos, #33

    call    #set_pixel

    ret

' =========================
' RESET OLED
' =========================

reset_oled

    drvl    #oled_reset
    waitx   ##20_000

    drvh    #oled_reset
    waitx   ##9_000_000

    ret

' =========================
' OLED INIT
' =========================

oled_init

    mov     cmd, #$AE
    call    #send_cmd

    mov     cmd, #$D5
    call    #send_cmd

    mov     cmd, #$80
    call    #send_cmd

    mov     cmd, #$A8
    call    #send_cmd

    mov     cmd, #$3F
    call    #send_cmd

    mov     cmd, #$D3
    call    #send_cmd

    mov     cmd, #0
    call    #send_cmd

    mov     cmd, #$40
    call    #send_cmd

    mov     cmd, #$A0
    call    #send_cmd

    mov     cmd, #$C0
    call    #send_cmd

    mov     cmd, #$DA
    call    #send_cmd

    mov     cmd, #$12
    call    #send_cmd

    mov     cmd, #$81
    call    #send_cmd

    mov     cmd, #$7F
    call    #send_cmd

    mov     cmd, #$20
    call    #send_cmd

    mov     cmd, #$02
    call    #send_cmd

    mov     cmd, #$A4
    call    #send_cmd

    mov     cmd, #$A6
    call    #send_cmd

    mov     cmd, #$8D
    call    #send_cmd

    mov     cmd, #$14
    call    #send_cmd

    mov     cmd, #$AF
    call    #send_cmd

    ret

' =========================
' SEND COMMAND
' =========================

send_cmd

    drvl    #oled_cs
    drvl    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret

' =========================
' SEND DATA
' =========================

send_data

    drvl    #oled_cs
    drvh    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret

' =========================
' SET PAGE POSITION
' =========================

set_pos

    mov     cmd, page
    or      cmd, #$B0

    call    #send_cmd

    mov     cmd, #$00
    call    #send_cmd

    mov     cmd, #$10
    call    #send_cmd

    ret

' =========================
' CLEAR HUB FRAMEBUFFER
' =========================

clear_buffer

    mov     ptr, ##frame_buffer
    mov     count, ##256
    mov     value, #0

clear_buffer_loop

    wrlong  value, ptr

    add     ptr, #4

    djnz    count, #clear_buffer_loop

    ret

' =========================
' PUSH HUB FRAMEBUFFER
' =========================

push_buffer

    ' Read the HUB framebuffer from the end toward the beginning.
    ' Reversing byte order and bit order performs a 180-degree
    ' software rotation while keeping the OLED at $A0 / $C0.

    mov     ptr, ##frame_buffer
    add     ptr, ##1023

    mov     page, #0
    mov     page_count, #8

push_page_loop

    call    #set_pos
    mov     count, #128

push_column_loop

    rdbyte  cmd, ptr
    call    #rotate_display_byte
    call    #send_data

    sub     ptr, #1
    djnz    count, #push_column_loop

    add     page, #1
    djnz    page_count, #push_page_loop

    ret


' =========================
' REVERSE DATA BYTE FOR DISPLAY
'
' $A0/$C0 are kept as the controller's
' normal directions.  The module is mounted
' 180 degrees from the chosen viewing orientation,
' so framebuffer output is rotated in software.
' =========================

rotate_display_byte

    mov     rot_src, cmd
    mov     rot_dst, #0
    mov     rot_count, #8

rotate_display_byte_loop

    shl     rot_dst, #1
    testb   rot_src, #0 wc
if_c or      rot_dst, #1
    shr     rot_src, #1

    djnz    rot_count, #rotate_display_byte_loop

    mov     cmd, rot_dst
    ret

' =========================
' SET PIXEL IN HUB RAM
' =========================

set_pixel

    mov     offset, ypos

    shr     offset, #3
    shl     offset, #7

    add     offset, xpos

    mov     ptr, ##frame_buffer
    add     ptr, offset

    rdbyte  value, ptr

    mov     mask, #1

    mov     temp, ypos
    and     temp, #7

    shl     mask, temp

    or      value, mask

    wrbyte  value, ptr

    ret

' =========================
' CLEAR PIXEL IN HUB RAM
' =========================

clear_pixel

    mov     offset, ypos

    shr     offset, #3
    shl     offset, #7

    add     offset, xpos

    mov     ptr, ##frame_buffer
    add     ptr, offset

    rdbyte  value, ptr

    mov     mask, #1

    mov     temp, ypos
    and     temp, #7

    shl     mask, temp

    xor     mask, #$FF

    and     value, mask

    wrbyte  value, ptr

    ret

' =========================
' DRAW HORIZONTAL LINE
' =========================

draw_hline

draw_hline_loop

    call    #set_pixel

    add     xpos, #1

    djnz    line_count, #draw_hline_loop

    ret

' =========================
' DRAW VERTICAL LINE
' =========================

draw_vline

draw_vline_loop

    call    #set_pixel

    add     ypos, #1

    djnz    line_count, #draw_vline_loop

    ret

' =========================
' FRAME DELAY
'
' Short delay gives the ship
' a smooth flying speed.
' =========================

frame_delay

    waitx   ##6_000_000

    ret

' =========================
' SOFTWARE SPI
' =========================

spi8

    mov     spi_count, #8

.loop

    testb   cmd, #7 wc

    outc    #oled_mosi

    waitx   ##100

    drvh    #oled_sck

    waitx   ##100

    drvl    #oled_sck

    waitx   ##100

    rol     cmd, #1

    djnz    spi_count, #.loop

    ret

' =========================
' END
' =========================

end

    jmp     #end

' =========================
' VARIABLES
' =========================

cmd             res 1
count           res 1
spi_count       res 1

page            res 1
page_count      res 1

xpos            res 1
ypos            res 1

temp            res 1
ptr             res 1

value           res 1
offset          res 1
mask            res 1

line_count      res 1
row_count       res 1
column_count    res 1

ship_x          res 1
flame_frame     res 1

' =========================
' HUB RAM
' =========================


rot_src         res 1
rot_dst         res 1
rot_count       res 1

    orgh

' =========================
' FRAMEBUFFER
'
' 128 x 64 monochrome OLED
'
' 8 pages x 128 bytes
'
' = 1024 bytes
' =========================

frame_buffer

    byte    0[1024]