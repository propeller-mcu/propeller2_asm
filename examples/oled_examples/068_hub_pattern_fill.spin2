' =========================================================
'
' P2ASM OLED DEMO 068 / 119
'
' HUB Pattern Fill
'
' Category: HUB RAM Graphics
'
' =========================================================

CON

    _CLKFREQ = 180_000_000

    oled_sck   = 0
    oled_mosi  = 1
    oled_reset = 2
    oled_dc    = 3
    oled_cs    = 4

DAT

    org 0
    asmclk

' -------------------------
' GPIO INIT
' -------------------------

    drvh    #oled_cs
    drvh    #oled_dc
    drvl    #oled_sck
    dirh    #oled_mosi
    dirh    #oled_dc
    dirh    #oled_reset
    dirh    #oled_cs
    dirh    #oled_sck

' =========================
' MAIN
' =========================

main

    call    #reset_oled
    call    #oled_init

    ' Fill the entire HUB
    ' framebuffer with a
    ' repeating 8-byte pattern.

    call    #build_hub_pattern_fill

    ' Transfer the completed
    ' framebuffer to the OLED.

    call    #push_buffer

    jmp     #end

' =========================
' RESET OLED
' =========================

reset_oled

    drvl    #oled_reset

    waitx   ##20_000

    drvh    #oled_reset

    waitx   ##9_000_000

    ret

' =========================
' OLED INIT
' =========================

oled_init

    mov     cmd, #$AE
    call    #send_cmd

    mov     cmd, #$D5
    call    #send_cmd

    mov     cmd, #$80
    call    #send_cmd

    mov     cmd, #$A8
    call    #send_cmd

    mov     cmd, #$3F
    call    #send_cmd

    mov     cmd, #$D3
    call    #send_cmd

    mov     cmd, #0
    call    #send_cmd

    mov     cmd, #$40
    call    #send_cmd

    mov     cmd, #$A0
    call    #send_cmd

    mov     cmd, #$C0
    call    #send_cmd

    mov     cmd, #$DA
    call    #send_cmd

    mov     cmd, #$12
    call    #send_cmd

    mov     cmd, #$81
    call    #send_cmd

    mov     cmd, #$7F
    call    #send_cmd

    mov     cmd, #$20
    call    #send_cmd

    mov     cmd, #$02
    call    #send_cmd

    mov     cmd, #$A4
    call    #send_cmd

    mov     cmd, #$A6
    call    #send_cmd

    mov     cmd, #$8D
    call    #send_cmd

    mov     cmd, #$14
    call    #send_cmd

    mov     cmd, #$AF
    call    #send_cmd

    ret

' =========================
' SEND COMMAND
' =========================

send_cmd

    drvl    #oled_cs
    drvl    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret

' =========================
' SEND DATA
' =========================

send_data

    drvl    #oled_cs
    drvh    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret

' =========================
' SET PAGE POSITION
'
' page = 0 through 7
' =========================

set_pos

    mov     cmd, page
    or      cmd, #$B0

    call    #send_cmd

    mov     cmd, #$00
    call    #send_cmd

    mov     cmd, #$10
    call    #send_cmd

    ret

' =========================
' SET X POSITION
'
' xpos = 0 through 127
' =========================

set_xpos

    mov     temp, xpos
    and     temp, #$0F

    mov     cmd, temp
    call    #send_cmd

    mov     temp, xpos
    shr     temp, #4
    and     temp, #$0F
    or      temp, #$10

    mov     cmd, temp
    call    #send_cmd

    ret

' =========================
' PUSH HUB FRAMEBUFFER
'
' Copies all 1024 framebuffer
' bytes from HUB RAM to OLED RAM.
' =========================

push_buffer

    ' Start at the final
    ' framebuffer byte.
    '
    ' Reading bytes backward
    ' and reversing the bits
    ' in each byte performs
    ' the required 180-degree
    ' software rotation.

    mov     ptr, ##frame_buffer
    add     ptr, ##1023

    mov     page, #0
    mov     page_count, #8

push_page_loop

    call    #set_pos

    mov     count, #128

push_column_loop

    rdbyte  cmd, ptr

    call    #rotate_display_byte
    call    #send_data

    sub     ptr, #1

    djnz    count, #push_column_loop

    add     page, #1

    djnz    page_count, #push_page_loop

    ret

' =========================
' REVERSE DATA BYTE
' FOR DISPLAY
'
' Reverses all 8 bits
' contained in cmd.
'
' Example:
'
' %10000001
'
' stays:
'
' %10000001
'
' while:
'
' %01000010
'
' also remains symmetrical.
' =========================

rotate_display_byte

    mov     rot_src, cmd
    mov     rot_dst, #0
    mov     rot_count, #8

rotate_display_byte_loop

    shl     rot_dst, #1

    testb   rot_src, #0 wc

if_c or    rot_dst, #1

    shr     rot_src, #1

    djnz    rot_count, #rotate_display_byte_loop

    mov     cmd, rot_dst

    ret

' =========================
' HUB PATTERN FILL
'
' Writes an 8-byte repeating
' pattern across all 1024
' framebuffer bytes.
'
' pattern_index ranges:
'
' 0 through 7
'
' and then wraps back to 0.
' =========================

build_hub_pattern_fill

    mov     ptr, ##frame_buffer

    mov     source_ptr, ##pattern_bytes

    mov     pattern_index, #0

    mov     count, ##1024

pattern_fill_loop

    ' Copy the pattern index
    ' into a temporary value.

    mov     temp, pattern_index

    ' Start at the beginning
    ' of the pattern table.

    mov     source_ptr, ##pattern_bytes

    ' Move to the selected
    ' pattern byte.

    add     source_ptr, temp

    ' Read the selected byte.

    rdbyte  value, source_ptr

    ' Store it in the current
    ' framebuffer location.

    wrbyte  value, ptr

    ' Advance framebuffer
    ' destination.

    add     ptr, #1

    ' Select next pattern byte.

    add     pattern_index, #1

    ' Keep index between
    ' 0 and 7.
    '
    ' Because 8 is a power
    ' of two:
    '
    ' index AND 7
    '
    ' performs the wrap.

    and     pattern_index, #7

    djnz    count, #pattern_fill_loop

    ret

' =========================
' SOFTWARE SPI
'
' Slow / beginner-friendly
' bit-banged SPI.
' =========================

spi8

    mov     spi_count, #8

.loop

    ' Copy bit 7 of cmd
    ' into carry.

    testb   cmd, #7 wc

    ' Send carry state
    ' to MOSI.

    outc    #oled_mosi

    waitx   ##100

    ' Clock HIGH.

    drvh    #oled_sck

    waitx   ##100

    ' Clock LOW.

    drvl    #oled_sck

    waitx   ##100

    ' Rotate next bit
    ' into bit 7.

    rol     cmd, #1

    djnz    spi_count, #.loop

    ret

' =========================
' END
' =========================

end

    jmp     #end

' =========================
' VARIABLES
' =========================

cmd             res 1
count           res 1
spi_count       res 1

page            res 1
page_count      res 1

xpos            res 1
ypos            res 1

temp            res 1

ptr             res 1
value           res 1

offset          res 1
mask            res 1

source_ptr      res 1
pattern_index   res 1

rot_src         res 1
rot_dst         res 1
rot_count       res 1

    orgh

' =========================
' HUB RAM FRAMEBUFFER
'
' 128 x 64 monochrome OLED
'
' 8 pages
'
' x
'
' 128 bytes per page
'
' =
'
' 1024 bytes
' =========================

frame_buffer

    byte    0[1024]

' =========================
' REPEATING PATTERN
'
' Eight bytes are repeated
' across the entire framebuffer.
'
' Binary forms:
'
' $81 = %10000001
' $42 = %01000010
' $24 = %00100100
' $18 = %00011000
' $18 = %00011000
' $24 = %00100100
' $42 = %01000010
' $81 = %10000001
'
' This creates a repeating
' symmetrical diamond / X-like
' 8-column pattern.
' =========================

pattern_bytes

    byte    $81,$42,$24,$18,$18,$24,$42,$81