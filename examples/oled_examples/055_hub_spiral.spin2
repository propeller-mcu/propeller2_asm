' =========================================================
'
' P2ASM OLED DEMO 055 / 119
'
' HUB Spiral
'
' Category: HUB RAM Graphics
'
' =========================================================

CON

    _CLKFREQ = 180_000_000

    oled_sck   = 0
    oled_mosi  = 1
    oled_reset = 2
    oled_dc    = 3
    oled_cs    = 4

DAT

    org 0
    asmclk

' -------------------------
' GPIO INIT
' -------------------------

    drvh    #oled_cs
    drvh    #oled_dc
    drvl    #oled_sck
    dirh    #oled_mosi
    dirh    #oled_dc
    dirh    #oled_reset
    dirh    #oled_cs
    dirh    #oled_sck

' =========================
' MAIN
' =========================

main

    call    #reset_oled
    call    #oled_init
    call    #clear_buffer

    mov     point_ptr, ##spiral_points
    mov     point_count, ##173

    call    #draw_point_list
    call    #push_buffer

    jmp     #end

' =========================
' RESET OLED
' =========================

reset_oled

    drvl    #oled_reset

    waitx   ##20_000

    drvh    #oled_reset

    waitx   ##9_000_000

    ret

' =========================
' OLED INIT
' =========================

oled_init

    mov     cmd, #$AE
    call    #send_cmd

    mov     cmd, #$D5
    call    #send_cmd

    mov     cmd, #$80
    call    #send_cmd

    mov     cmd, #$A8
    call    #send_cmd

    mov     cmd, #$3F
    call    #send_cmd

    mov     cmd, #$D3
    call    #send_cmd

    mov     cmd, #0
    call    #send_cmd

    mov     cmd, #$40
    call    #send_cmd

    mov     cmd, #$A0
    call    #send_cmd

    mov     cmd, #$C0
    call    #send_cmd

    mov     cmd, #$DA
    call    #send_cmd

    mov     cmd, #$12
    call    #send_cmd

    mov     cmd, #$81
    call    #send_cmd

    mov     cmd, #$7F
    call    #send_cmd

    mov     cmd, #$20
    call    #send_cmd

    mov     cmd, #$02
    call    #send_cmd

    mov     cmd, #$A4
    call    #send_cmd

    mov     cmd, #$A6
    call    #send_cmd

    mov     cmd, #$8D
    call    #send_cmd

    mov     cmd, #$14
    call    #send_cmd

    mov     cmd, #$AF
    call    #send_cmd

    ret

' =========================
' SEND COMMAND
' =========================

send_cmd

    drvl    #oled_cs
    drvl    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret

' =========================
' SEND DATA
' =========================

send_data

    drvl    #oled_cs
    drvh    #oled_dc

    call    #spi8

    drvh    #oled_cs

    ret

' =========================
' SET PAGE POSITION
'
' page = 0 through 7
' =========================

set_pos

    mov     cmd, page
    or      cmd, #$B0
    call    #send_cmd

    mov     cmd, #$00
    call    #send_cmd

    mov     cmd, #$10
    call    #send_cmd

    ret

' =========================
' SET X POSITION
'
' xpos = 0 through 127
' =========================

set_xpos

    mov     temp, xpos
    and     temp, #$0F

    mov     cmd, temp
    call    #send_cmd

    mov     temp, xpos
    shr     temp, #4
    and     temp, #$0F
    or      temp, #$10

    mov     cmd, temp
    call    #send_cmd

    ret

' =========================
' CLEAR HUB FRAMEBUFFER
'
' Clears 1024 bytes in HUB RAM.
' The OLED is not touched here.
' =========================

clear_buffer

    mov     ptr, ##frame_buffer
    mov     count, ##256
    mov     value, #0

clear_buffer_loop

    wrlong  value, ptr

    add     ptr, #4

    djnz    count, #clear_buffer_loop

    ret

' =========================
' PUSH HUB FRAMEBUFFER
'
' Copies all 1024 framebuffer
' bytes from HUB RAM to OLED RAM.
' =========================

push_buffer

    ' Read the HUB framebuffer from the end toward the beginning.
    ' Reversing byte order and bit order performs a 180-degree
    ' software rotation while keeping the OLED at $A0 / $C0.

    mov     ptr, ##frame_buffer
    add     ptr, ##1023

    mov     page, #0
    mov     page_count, #8

push_page_loop

    call    #set_pos

    mov     count, #128

push_column_loop

    rdbyte  cmd, ptr

    call    #rotate_display_byte
    call    #send_data

    sub     ptr, #1

    djnz    count, #push_column_loop

    add     page, #1

    djnz    page_count, #push_page_loop

    ret

' =========================
' REVERSE DATA BYTE FOR DISPLAY
'
' $A0/$C0 are kept as the controller's
' normal directions. The module is mounted
' 180 degrees from the chosen viewing orientation,
' so framebuffer output is rotated in software.
' =========================

rotate_display_byte

    mov     rot_src, cmd
    mov     rot_dst, #0
    mov     rot_count, #8

rotate_display_byte_loop

    shl     rot_dst, #1

    testb   rot_src, #0 wc

    if_c    or      rot_dst, #1

    shr     rot_src, #1

    djnz    rot_count, #rotate_display_byte_loop

    mov     cmd, rot_dst

    ret

' =========================
' SET PIXEL IN HUB RAM
'
' xpos = 0 through 127
' ypos = 0 through 63
'
' No OLED write occurs here.
' Only frame_buffer is modified.
' =========================

set_pixel

    mov     offset, ypos
    shr     offset, #3
    shl     offset, #7
    add     offset, xpos

    mov     ptr, ##frame_buffer
    add     ptr, offset

    rdbyte  value, ptr

    mov     mask, #1

    mov     temp, ypos
    and     temp, #7

    shl     mask, temp

    or      value, mask

    wrbyte  value, ptr

    ret

' =========================
' DRAW POINT LIST
'
' Each point in HUB RAM contains:
'
' X byte
' Y byte
'
' point_ptr walks through the
' coordinate table.
'
' ptr remains available for
' set_pixel framebuffer access.
' =========================

draw_point_list

point_list_loop

    rdbyte  xpos, point_ptr
    add     point_ptr, #1

    rdbyte  ypos, point_ptr
    add     point_ptr, #1

    call    #set_pixel

    djnz    point_count, #point_list_loop

    ret

' =========================
' SOFTWARE SPI
' =========================

spi8

    mov     spi_count, #8

.loop

    testb   cmd, #7 wc

    outc    #oled_mosi

    waitx   ##100

    drvh    #oled_sck
    waitx   ##100

    drvl    #oled_sck
    waitx   ##100

    rol     cmd, #1

    djnz    spi_count, #.loop

    ret

' =========================
' END
' =========================

end

    jmp     #end

' =========================
' VARIABLES
' =========================

cmd          res 1
count        res 1
spi_count    res 1
page         res 1
page_count   res 1
xpos         res 1
ypos         res 1
temp         res 1
ptr          res 1
point_ptr    res 1
value        res 1
offset       res 1
mask         res 1
point_count  res 1

rot_src      res 1
rot_dst      res 1
rot_count    res 1

' =========================
' HUB RAM FRAMEBUFFER
'
' 128 x 64 monochrome OLED
'
' 8 pages x 128 bytes
' = 1024 bytes
' =========================

    orgh

frame_buffer

    byte    0[1024]

' =========================
' SPIRAL POINT DATA
'
' Each pair is:
'
' X, Y
'
' 173 total points.
' =========================

spiral_points

    byte    64,32,64,33,63,33,62,33,62,32,61,32,61,31,62,31

    byte    62,30,63,30,64,29,65,29,66,29,66,30,67,30,68,30

    byte    69,31,69,32,69,33,69,34,68,35,67,35,66,36,65,36

    byte    64,36,63,36,62,36,61,36,60,36,59,35,58,35,58,34

    byte    57,34,57,33,56,33,56,32,56,31,56,30,57,29,58,28

    byte    59,28,59,27,60,27,61,27,62,26,63,26,64,26,66,26

    byte    67,26,68,26,69,27,70,27,71,27,72,28,72,29,73,29

    byte    74,30,74,31,74,32,74,33,74,34,74,35,73,35,73,36

    byte    72,37,71,38,70,38,69,39,68,39,66,39,65,40,64,40

    byte    62,40,61,40,59,39,58,39,57,38,56,38,55,37,54,37

    byte    53,36,52,35,51,34,51,33,51,32,51,31,51,30,52,29

    byte    52,28,53,27,54,26,55,25,56,25,58,24,59,23,61,23

    byte    62,23,64,23,66,23,67,23,69,23,71,23,72,24,74,25

    byte    75,25,76,26,78,27,78,28,79,30,79,31,80,32,80,33

    byte    79,34,79,36,78,37,77,38,76,39,75,40,74,41,72,41

    byte    70,42,68,43,66,43,64,43,62,43,60,43,58,43,56,42

    byte    54,42,53,41,51,40,50,39,48,38,47,36,47,35,46,34

    byte    46,32,46,31,46,30,46,28,47,27,48,25,49,24,51,23

    byte    53,22,54,21,56,20,59,20,61,19,63,19,66,19,68,19

    byte    70,20,72,20,75,21,77,22,79,23,80,24,82,25,83,27

    byte    84,28,84,30,85,31,85,33,85,35,84,36,83,38,82,39

    byte    81,41,79,42,77,43,75,44,73,45